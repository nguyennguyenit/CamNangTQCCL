---
// Trang một bài viết theo artboard BaiVietDetail / BaiVietDetailMobile (component `bai-viet-chi-tiet` trong tokens.json).
// Thứ tự nội dung phục vụ cả người đọc lẫn máy trả lời (AEO/GEO): breadcrumb → tiêu đề + tác giả + ngày → hộp tóm tắt
// → mục lục → thân bài → FAQ → bài liên quan. Desktop (≥1100px) đặt mục lục + khối "Trong cẩm nang" ở cột phụ dính;
// dưới đó mục lục là khối mở/đóng ngay sau Tóm tắt (bản cột phụ ẩn bằng CSS nên trình đọc màn hình chỉ gặp một bản).
import SiteLayout from '../../layouts/SiteLayout.astro';
import BlogRelatedCard from './BlogRelatedCard.astro';
import {
  blogIndexPath,
  jsonLd,
  loadBlogPosts,
  relatedPosts,
  translationOf,
  type RenderedBlogPost,
} from '../../lib/blog-posts.ts';
import { articleJsonLd, blogCopy, breadcrumbJsonLd, faqJsonLd, formatPostDate, postImage } from '../../lib/blog-seo.ts';
import { blogGuideLink } from '../../lib/blog-guide-link.ts';
import { localePath } from '../../../js/i18n.js';
import { otherLocale } from '../../lib/locale-routes';

interface Props {
  post: RenderedBlogPost;
}

const { post } = Astro.props;
const locale = post.lang;
const copy = blogCopy(locale);
const site = Astro.site!;
const allPosts = await loadBlogPosts();
const translation = translationOf(post, allPosts);
const related = relatedPosts(post, allPosts);
const canonicalUrl = new URL(post.path, site);
const indexPath = blogIndexPath(locale);
const updated = post.updatedAt.slice(0, 10) !== post.publishedAt.slice(0, 10);
const structured = [
  articleJsonLd(post, site),
  breadcrumbJsonLd([
    { name: copy.home, path: localePath('/', locale) },
    { name: copy.blogName, path: indexPath },
    { name: post.title, path: post.path },
  ], site),
  ...(post.faq.length ? [faqJsonLd(post)] : []),
];
const image = postImage(post, site);
/** Câu trả lời FAQ là văn bản thuần; dòng trống tách đoạn. */
const faqItems = post.faq.map((entry) => ({ q: entry.q, paragraphs: entry.a.split(/\n{2,}/u) }));
const guide = await blogGuideLink(post);
/** Kicker "Bài viết · <chủ đề đầu>": bài không có trường thể loại nên lấy chủ đề đầu tiên (nếu có). */
const kicker = [copy.blogName, post.tags[0]].filter(Boolean).join(' · ');
const showToc = post.headings.length > 1;
---
<SiteLayout
  title={copy.articleTitle(post.title)}
  description={post.description}
  pageKind="detail"
  tagline={copy.tagline}
  canonicalUrl={canonicalUrl}
  ogType="article"
  ogImage={post.coverImage ? image : undefined}
  locale={locale}
  alternates={translation ? {vi: (locale === 'vi' ? post : translation).path, zh: (locale === 'zh' ? post : translation).path} : false}
  counterpartPath={translation ? translation.path : blogIndexPath(otherLocale(locale))}
>
  <!-- Hreflang chỉ khi có bản dịch cùng translationKey (SiteLayout khai); không có thì nút chuyển ngôn ngữ về danh sách bài bản kia. -->
  <Fragment slot="head">
    <meta property="article:published_time" content={post.publishedAt} />
    <meta property="article:modified_time" content={post.updatedAt} />
    <meta property="article:author" content={post.author.name} />
    {post.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="author" content={post.author.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={post.title} />
    <meta name="twitter:description" content={post.description} />
    <meta name="twitter:image" content={image} />
    {structured.map((data) => <script is:inline type="application/ld+json" set:html={jsonLd(data)}></script>)}
  </Fragment>

  <div class="bv-page">
    <nav class="bv-crumbs" aria-label={copy.breadcrumbLabel}>
      <ol>
        <li><a href={localePath('/', locale)}>{copy.home}</a></li>
        <li><a href={indexPath}>{copy.blogName}</a></li>
        <li><span aria-current="page">{post.title}</span></li>
      </ol>
    </nav>

    <div class="bv-grid">
      <article class="bv-article" aria-labelledby="blog-article-title">
        <header class="bv-head">
          <p class="bv-kicker">{kicker}</p>
          <h1 id="blog-article-title" class="bv-title">{post.title}</h1>
          <p class="bv-meta">
            <span>{copy.author}: <span class="bv-author">{post.author.name}</span></span>
            <span aria-hidden="true">·</span>
            <span>{copy.published} <time datetime={post.publishedAt}>{formatPostDate(post.publishedAt, locale)}</time></span>
            {updated && (
              <>
                <span aria-hidden="true">·</span>
                <span>{copy.updated} <time datetime={post.updatedAt}>{formatPostDate(post.updatedAt, locale)}</time></span>
              </>
            )}
            <span aria-hidden="true">·</span>
            <span class="bv-read">
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><polyline points="12 7 12 12 15 14"></polyline></svg>
              {copy.readingTime(post.readingMinutes)}
            </span>
          </p>
          {(post.tags.length > 0 || translation) && (
            <div class="bv-head-row">
              {post.tags.length > 0 && (
                <ul class="bv-tags" aria-label={copy.tags}>
                  {post.tags.map((tag) => <li class="bv-tag">{tag}</li>)}
                </ul>
              )}
              {translation && (
                <a class="bv-translation" href={translation.path} hreflang={copy.translationLang} lang={copy.translationLang}>{copy.translation}</a>
              )}
            </div>
          )}
        </header>

        {post.coverImage && (
          <figure class="bv-cover"><img src={post.coverImage} alt="" decoding="async" /></figure>
        )}

        <aside id="blog-summary" class="bv-summary" aria-label={copy.summary}>
          <p class="bv-label">{copy.summary}</p>
          <p>{post.description}</p>
        </aside>

        {showToc && (
          <details class="bv-toc-mobile" open>
            <summary>
              <span class="bv-label">{copy.toc}</span>
              <span class="bv-toc-count">{copy.tocCount(post.headings.length)}</span>
              <span class="bv-chevron" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span>
            </summary>
            <nav aria-label={copy.toc}>
              <ol class="bv-toc-list">
                {post.headings.map((heading, index) => (
                  <li class:list={[heading.depth === 3 && 'bv-toc-sub']}><a href={`#${heading.id}`} aria-current={index === 0 ? 'location' : undefined}>{heading.text}</a></li>
                ))}
              </ol>
            </nav>
          </details>
        )}

        <div id="blog-body" class="bv-body">
          <Fragment set:html={post.html} />
        </div>

        {post.faq.length > 0 && (
          <section id="blog-faq" class="bv-faq" aria-labelledby="blog-faq-title">
            <h2 id="blog-faq-title">{copy.faq}</h2>
            {faqItems.map((entry, index) => (
              <details class="bv-faq-item" open={index === 0}>
                <summary>
                  {entry.q}
                  <span class="bv-chevron" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span>
                </summary>
                {entry.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </details>
            ))}
          </section>
        )}
      </article>

      <aside class="bv-side" aria-label={copy.sideNav}>
        {showToc && (
          <nav id="blog-toc" class="bv-toc" aria-label={copy.toc}>
            <p class="bv-label">{copy.toc}</p>
            <ol class="bv-toc-list">
              {post.headings.map((heading, index) => (
                <li class:list={[heading.depth === 3 && 'bv-toc-sub']}><a href={`#${heading.id}`} aria-current={index === 0 ? 'location' : undefined}>{heading.text}</a></li>
              ))}
            </ol>
          </nav>
        )}
        <div class="bv-guide">
          <p class="bv-label">{copy.guide}</p>
          <p class="bv-guide-text">{guide.text}</p>
          <a class="bv-guide-link" href={guide.href}>
            {guide.label}
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="13 6 19 12 13 18"></polyline></svg>
          </a>
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section id="blog-related" class="bv-related" aria-labelledby="blog-related-title">
        <h2 id="blog-related-title">{copy.related}</h2>
        <div class="bv-related-grid">
          {related.map((other) => <BlogRelatedCard post={other} />)}
        </div>
      </section>
    )}

    <nav class="bv-back" aria-label={copy.backLabel}>
      <a href={indexPath}>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="11 6 5 12 11 18"></polyline></svg>
        {copy.back}
      </a>
    </nav>
  </div>

  <script is:inline type="module" slot="scripts" src="/js/blog-toc-current.js"></script>
</SiteLayout>
