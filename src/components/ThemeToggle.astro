---
/**
 * Nút đổi giao diện (header + đầu menu mobile). Icon nói theme đang bật: sáng hiện mặt trăng, tối hiện mặt trời;
 * CSS chọn icon theo `html[data-theme]` (script chặn nháy đặt trước stylesheet) nên icon đúng ngay lần vẽ đầu.
 * Tên truy cập và tooltip nói hành động sẽ xảy ra; js/site-chrome.js đổi chúng theo theme từ hai data attribute.
 * Giá trị render sẵn là của theme sáng (mặc định CSS khi không có JS).
 */
interface Props {
  id: string;
  toDark: string;
  toLight: string;
}
const { id, toDark, toLight } = Astro.props;
---
<button id={id} class="icon-btn theme-toggle" type="button" data-theme-toggle data-label-to-dark={toDark} data-label-to-light={toLight} title={toDark} aria-label={toDark}>
  <svg class="theme-icon theme-icon-moon" data-theme-icon="moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
  <svg class="theme-icon theme-icon-sun" data-theme-icon="sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
</button>
