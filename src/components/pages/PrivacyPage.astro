---
// Chính sách bảo mật dùng chung cho bản Việt (`/chinh-sach-bao-mat/`) và bản Trung (`/zh/chinh-sach-bao-mat/`).
// Đây là URL khai trên màn hình đồng ý OAuth của Google: nội dung phải khớp dữ liệu mà code thực sự
// thu thập (community-worker/, worker/, js/community-*.js, bảng trạng thái cục bộ ở docs/system-architecture.md).
import PolicyPage, { type PolicySection } from './PolicyPage.astro';
import { pick } from '../../../js/i18n.js';
import type { SiteLocale } from '../../lib/locale-routes';

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
const t = (vi: string, zh: string): string => pick(locale, vi, zh);

const title = t('Chính sách bảo mật', '隐私政策');
const lead = t(
  'Trang này giải thích Cẩm Nang TQCCL (tqccl.com) thu thập dữ liệu gì, dùng vào việc gì, lưu ở đâu và cách bạn yêu cầu xoá.',
  '本页说明《三国志战略版攻略手册》（tqccl.com）收集哪些数据、用途是什么、存放在哪里，以及你如何申请删除。',
);

const sections: PolicySection[] = [
  {
    id: 'khi-duyet-web',
    heading: t('Khi bạn chỉ xem cẩm nang', '仅浏览手册时'),
    paragraphs: [
      t(
        'Xem đội hình, tra cứu và dùng công cụ không cần tài khoản. Site không đặt quảng cáo, không dùng công cụ phân tích hay theo dõi của bên thứ ba và không đặt cookie khi bạn chưa đăng nhập.',
        '浏览阵容、查询资料和使用工具都无需账号。本站不投放广告，不使用任何第三方分析或追踪工具，未登录时不设置 Cookie。',
      ),
      t(
        'Site được phục vụ qua Cloudflare, nên Cloudflare xử lý các thông tin kỹ thuật của mỗi lần truy cập (như địa chỉ IP) để phân phối nội dung và chống tấn công.',
        '本站经由 Cloudflare 提供服务，Cloudflare 会为分发内容和防御攻击处理每次访问的技术信息（例如 IP 地址）。',
      ),
    ],
  },
  {
    id: 'dang-nhap-google',
    heading: t('Đăng nhập bằng Google', '使用 Google 登录'),
    paragraphs: [
      t(
        'Đăng nhập là tuỳ chọn, chỉ cần khi bạn muốn bình luận hoặc gửi chiến báo. Site chỉ hỗ trợ đăng nhập bằng Google và nhận từ Google:',
        '登录是可选的，仅在你想发表评论或提交战报时需要。本站只支持 Google 登录，并从 Google 获得：',
      ),
    ],
    items: [
      t('Tên hiển thị và ảnh đại diện — hiện công khai cạnh bình luận và chiến báo đã duyệt của bạn.', '显示名称和头像——会公开显示在你的评论和已通过审核的战报旁。'),
      t('Địa chỉ email — không bao giờ hiển thị công khai; dùng để nhận diện tài khoản và tài khoản quản trị.', '电子邮箱地址——从不公开显示，仅用于识别账号及管理员账号。'),
      t(
        'Mã xác thực do Google cấp trong quá trình đăng nhập — chỉ dùng để xác thực, site không đọc dữ liệu nào khác trong tài khoản Google của bạn.',
        '登录过程中 Google 签发的验证令牌——仅用于身份验证，本站不会读取你 Google 账号中的任何其他数据。',
      ),
    ],
  },
  {
    id: 'phien-cookie',
    heading: t('Phiên đăng nhập và cookie', '登录会话与 Cookie'),
    paragraphs: [
      t(
        'Sau khi đăng nhập, trình duyệt giữ cookie phiên (Better Auth) để bạn không phải đăng nhập lại. Máy chủ lưu phiên kèm địa chỉ IP và thông tin trình duyệt (user agent) để bảo vệ tài khoản; phiên tự hết hạn và bị xoá khi bạn đăng xuất. Đây là cookie cần thiết, không dùng để quảng cáo hay theo dõi.',
        '登录后，浏览器会保存会话 Cookie（Better Auth），让你无需重复登录。服务器会连同 IP 地址和浏览器信息（User-Agent）一起保存会话，用于保护账号；会话到期自动失效，退出登录时即被删除。该 Cookie 属于必要 Cookie，不用于广告或追踪。',
      ),
    ],
  },
  {
    id: 'binh-luan-chien-bao',
    heading: t('Bình luận và chiến báo', '评论与战报'),
    items: [
      t(
        'Bình luận: lưu nội dung, trang, ngôn ngữ và thời điểm gửi; hiện công khai kèm tên và ảnh đại diện. Bạn tự xoá được bình luận của mình.',
        '评论：保存内容、所在页面、语言和发表时间，并连同你的名称和头像公开显示。你可以自行删除自己的评论。',
      ),
      t(
        'Ảnh chiến báo: ảnh chụp màn hình bạn tải lên được lưu trên Cloudflare R2 và gửi tới Alibaba Cloud Model Studio (DashScope, mô hình Qwen) để AI đọc kết quả trận và tướng hai bên. Ảnh đã tải lên nhưng không gửi thành chiến báo sẽ tự động bị xoá sau 24 giờ.',
        '战报截图：你上传的截图保存在 Cloudflare R2，并发送至阿里云百炼（DashScope，通义千问 Qwen 模型），由 AI 识别对局结果和双方武将。已上传但未提交为战报的截图会在 24 小时后自动删除。',
      ),
      t(
        'Chiến báo đã gửi (ảnh, kết quả, tướng, ghi chú, mùa) chờ quản trị viên duyệt. Chỉ chiến báo được duyệt mới công khai; trước đó ảnh chỉ bạn và quản trị viên xem được.',
        '已提交的战报（截图、结果、武将、备注、赛季）需经管理员审核。只有通过审核的战报才会公开；在此之前截图仅你本人和管理员可见。',
      ),
      t(
        'Quản trị viên có thể xoá bình luận và từ chối chiến báo vi phạm nội quy.',
        '管理员可以删除违规评论，并拒绝违规战报。',
      ),
    ],
  },
  {
    id: 'gop-y',
    heading: t('Góp ý, sửa lỗi', '意见反馈'),
    paragraphs: [
      t(
        'Nút "Góp ý, sửa lỗi" ở chân trang không cần đăng nhập. Site lưu loại góp ý, tiêu đề, nội dung, đường dẫn trang bạn đang xem, ngôn ngữ, thời điểm gửi và email nếu bạn để lại (khi đã đăng nhập, email tài khoản được điền sẵn và bạn có thể xoá). Góp ý không hiển thị công khai; chỉ quản trị viên xem được.',
        '页脚的“意见反馈”按钮无需登录。本站会保存反馈类型、标题、内容、你正在浏览的页面路径、语言、提交时间，以及你留下的邮箱（已登录时会自动填入账号邮箱，你可以删除）。反馈不会公开显示，仅管理员可见。',
      ),
      t(
        'Mỗi góp ý được gửi thành một email tới hộp thư của quản trị viên qua Cloudflare Email Service. Email bạn để lại chỉ dùng để trả lời góp ý đó.',
        '每条反馈都会通过 Cloudflare Email Service 以邮件形式发送到管理员邮箱。你留下的邮箱仅用于回复该条反馈。',
      ),
      t(
        'Khi chưa đăng nhập, Cloudflare Turnstile kiểm tra để chặn bot; script Turnstile chỉ được nạp lúc bạn mở hộp thoại góp ý.',
        '未登录时由 Cloudflare Turnstile 进行人机验证；Turnstile 脚本只在你打开反馈对话框时加载。',
      ),
    ],
  },
  {
    id: 'cong-cu-doc-anh',
    heading: t('Công cụ đọc ảnh', '图片识别工具'),
    paragraphs: [
      t(
        'Công cụ "Soi đội từ ảnh" và "Gợi ý đội từ kho" nén ảnh ngay trong trình duyệt rồi gửi qua Cloudflare Worker tới Alibaba Cloud DashScope (Qwen) để nhận diện tướng và chiến pháp. Ảnh chỉ dùng cho lần đọc đó, site không lưu lại. Trước khi gửi, Cloudflare Turnstile kiểm tra để chặn bot; script Turnstile chỉ được nạp trên hai trang này và khi mở hộp thoại góp ý.',
        '“截图识阵”和“武将库配队”两个工具会先在浏览器中压缩图片，再经 Cloudflare Worker 发送至阿里云 DashScope（Qwen）识别武将和战法。图片仅用于本次识别，本站不会保存。发送前由 Cloudflare Turnstile 进行人机验证；Turnstile 脚本只在这两个页面以及打开反馈对话框时加载。',
      ),
    ],
  },
  {
    id: 'gioi-han-luot',
    heading: t('Giới hạn lượt dùng', '使用频率限制'),
    paragraphs: [
      t(
        'Để chống lạm dụng, site đếm số lượt thao tác: công cụ đọc ảnh và góp ý khi chưa đăng nhập đếm theo địa chỉ IP đã được băm (không lưu IP gốc), bình luận, chiến báo và góp ý khi đã đăng nhập đếm theo tài khoản, đăng nhập đếm theo IP. Bộ đếm tự hết hạn và bị xoá định kỳ.',
        '为防止滥用，本站会统计操作次数：图片识别工具和未登录时的反馈按经过哈希处理的 IP 地址计数（不保存原始 IP），评论、战报和已登录时的反馈按账号计数，登录按 IP 计数。计数器到期自动失效并定期清除。',
      ),
    ],
  },
  {
    id: 'luu-tren-may',
    heading: t('Dữ liệu lưu trên thiết bị của bạn', '保存在你设备上的数据'),
    paragraphs: [
      t(
        'Các dữ liệu sau chỉ nằm trong localStorage/sessionStorage của trình duyệt, không gửi về máy chủ; bạn xoá được bằng cách xoá dữ liệu trang web trong trình duyệt:',
        '以下数据只保存在浏览器的 localStorage/sessionStorage 中，不会发送到服务器；清除浏览器中的网站数据即可删除：',
      ),
    ],
    items: [
      t('Giao diện sáng/tối và cách hiển thị đội hình (thẻ/bảng).', '明暗主题和阵容显示方式（卡片/表格）。'),
      t('Nhật ký "Theo dõi chiêu mộ" (tài khoản, banner, lượt chiêu mộ).', '“招募记录”的数据（账号、卡池、招募次数）。'),
      t('Kho tướng và chiến pháp đã quét ở "Gợi ý đội từ kho".', '在“武将库配队”中扫描得到的武将与战法库。'),
      t('Dấu hiệu "đã từng đăng nhập" để chỉ kiểm tra phiên khi cần.', '“曾经登录过”的标记，仅在需要时才检查会话。'),
    ],
  },
  {
    id: 'ha-tang',
    heading: t('Nơi lưu trữ và bên xử lý', '存储位置与处理方'),
    items: [
      t(
        'Cloudflare: lưu trữ site (Pages), máy chủ API (Workers), cơ sở dữ liệu tài khoản, bình luận, chiến báo, góp ý (D1), ảnh chiến báo (R2), bộ đếm giới hạn (KV), Turnstile và gửi email góp ý (Email Service).',
        'Cloudflare：网站托管（Pages）、API 服务（Workers）、账号/评论/战报/反馈数据库（D1）、战报截图（R2）、频率计数（KV）、Turnstile 以及反馈邮件发送（Email Service）。',
      ),
      t('Google: xác thực đăng nhập.', 'Google：登录身份验证。'),
      t('Alibaba Cloud (DashScope, khu vực quốc tế): AI đọc ảnh.', '阿里云（DashScope 国际站）：AI 图片识别。'),
    ],
    closing: [
      t(
        'Site không bán, cho thuê hay chia sẻ dữ liệu cá nhân cho bên nào khác ngoài các bên xử lý trên, và không dùng dữ liệu để quảng cáo.',
        '除上述处理方外，本站不会出售、出租或向任何其他方分享个人数据，也不会将数据用于广告。',
      ),
    ],
  },
  {
    id: 'thoi-gian-luu',
    heading: t('Thời gian lưu', '保存期限'),
    paragraphs: [
      t(
        'Tài khoản, bình luận, chiến báo và góp ý được lưu cho đến khi bạn tự xoá hoặc yêu cầu xoá. Ảnh tải lên chưa gửi bị xoá sau 24 giờ; phiên đăng nhập và bộ đếm giới hạn tự hết hạn.',
        '账号、评论、战报和反馈会一直保存，直到你自行删除或申请删除。已上传但未提交的截图在 24 小时后删除；登录会话和频率计数器到期自动失效。',
      ),
    ],
  },
  {
    id: 'yeu-cau-xoa',
    heading: t('Quyền của bạn và yêu cầu xoá dữ liệu', '你的权利与删除数据申请'),
    contact: {
      before: t(
        'Bạn có thể đăng xuất bất cứ lúc nào, tự xoá bình luận của mình và thu hồi quyền truy cập của site tại trang quản lý tài khoản Google. Để xem, sửa hoặc xoá toàn bộ tài khoản cùng bình luận, chiến báo và ảnh liên quan, hãy gửi email từ địa chỉ Gmail bạn dùng để đăng nhập tới',
        '你可以随时退出登录、自行删除评论，并在 Google 账号管理页面撤销本站的访问权限。如需查看、更正或删除整个账号及相关评论、战报和截图，请使用登录所用的 Gmail 地址发送邮件至',
      ),
      after: t('. Chúng tôi sẽ xoá dữ liệu và phản hồi qua email khi hoàn tất.', '。我们会删除相关数据，并在完成后通过邮件回复你。'),
    },
  },
  {
    id: 'thay-doi',
    heading: t('Thay đổi chính sách', '政策变更'),
    paragraphs: [t('Khi chính sách thay đổi, nội dung và ngày hiệu lực trên trang này sẽ được cập nhật.', '政策如有变更，本页内容和生效日期将随之更新。')],
  },
];
---
<PolicyPage
  locale={locale}
  path="/chinh-sach-bao-mat/"
  idPrefix="privacy"
  title={title}
  description={t(
    'Cẩm Nang TQCCL thu thập dữ liệu gì khi bạn đăng nhập Google, bình luận, gửi chiến báo, gửi góp ý hoặc dùng công cụ đọc ảnh, lưu ở đâu và cách yêu cầu xoá.',
    '《三国志战略版攻略手册》在你使用 Google 登录、发表评论、提交战报、提交反馈或使用图片识别工具时收集哪些数据、存放在哪里以及如何申请删除。',
  )}
  lead={lead}
  effectiveDate="2026-09-28"
  sections={sections}
/>
