---
// Trang chi tiết Khai hoang dùng chung cho bản Việt (`/khai-hoang/<seg>/`) và bản Trung (`/zh/khai-hoang/<seg>/`).
// Tiêu đề bản zh ghép tên tướng chữ Hán (src/lib/team-detail-pages.ts), không dùng tên đội tiếng Việt.
import SiteLayout from '../../layouts/SiteLayout.astro';
import { familyReturnHref } from '../../../js/team-detail-navigation.js';
import { pick } from '../../../js/i18n.js';
import type { KhaiHoangDetailProps } from '../../lib/team-detail-pages';
import type { SiteLocale } from '../../lib/locale-routes';

type Props = KhaiHoangDetailProps & { locale: SiteLocale };

const {entry, title, pageLabel, khaiHoangSha256, locale} = Astro.props;
const t = (vi: string, zh: string): string => pick(locale, vi, zh);
// Canonical bỏ query/hash: `variant` và `from` là trạng thái deep-link, không phải URL riêng.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const fallbackReturn = familyReturnHref('khaihoang', { locale });
---
<SiteLayout
  title={`${pageLabel}${t(' — Khai hoang — Cẩm Nang Game Tam Quốc Chí - Chiến Lược', ' — 开荒 — 三国志战略版攻略手册')}`}
  description={locale === 'zh'
    ? `「${pageLabel}」开荒攻略：当前配置与全部已验证的备注。`
    : `Hướng dẫn khai hoang của đội ${pageLabel}: cấu hình đang chọn và toàn bộ ghi chú đã xác minh.`}
  pageKind="detail"
  activeSection="khaihoang"
  tagline={t('Chi tiết Khai hoang', '开荒详情')}
  canonicalUrl={canonicalUrl}
  ogType="article"
  locale={locale}
>
  <nav class="detail-back-row" aria-label={t('Quay lại danh sách Khai hoang', '返回开荒列表')}>
    <a id="team-return-link" class="detail-link detail-back-link" href={fallbackReturn} data-family-href={fallbackReturn}>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="11 6 5 12 11 18"></polyline></svg>
      {t('Quay lại Khai hoang', '返回开荒')}
    </a>
  </nav>

  <article
    id="team-detail-root"
    class="reference-detail"
    aria-labelledby="team-detail-title"
    aria-busy="true"
    data-family="khaihoang"
    data-khaihoang-team-id={entry.khaiHoangTeamId}
    data-khaihoang-sha256={khaiHoangSha256}
  >
    <div class="detail-header">
      <div class="detail-head-main">
        <div class="detail-title-row">
          <h1 id="team-detail-title" class="detail-title">{title}</h1>
        </div>
        <!-- Huy hiệu loại binh của cấu hình đang chọn do js/khaihoang-detail.js gắn. -->
        <div id="team-detail-badges" class="detail-badges" hidden></div>
      </div>
      <!-- Panel của Khai hoang không có điểm; nút sao chép link do JS gắn. -->
      <div id="team-detail-panel" class="detail-score-panel" hidden>
        <div id="team-detail-actions" class="detail-panel-actions"></div>
      </div>
    </div>

    <div id="team-detail-status" class="detail-state" role="status" aria-live="polite" aria-atomic="true">{t('Đang tải chi tiết…', '正在加载详情…')}</div>
    <noscript>
      <p class="scope-note">{t(
        'Trang chi tiết cần JavaScript để đọc dữ liệu Khai hoang đã xác minh. Bạn vẫn có thể quay lại danh sách Khai hoang bằng liên kết phía trên.',
        '详情页需要 JavaScript 才能读取已验证的开荒数据。你仍可通过上方链接返回开荒列表。',
      )}</p>
    </noscript>
    <div id="team-detail-body" hidden></div>
  </article>

  <!-- Chiến báo thực chiến + bình luận do js/community-page.js dựng; dịch vụ cộng đồng lỗi thì chỉ khối này báo. -->
  <section id="community-root" class="cm-root"></section>

  <script is:inline type="module" src="/js/khaihoang-detail.js" slot="scripts"></script>
  <script is:inline type="module" src="/js/community-page.js" slot="scripts"></script>
</SiteLayout>
