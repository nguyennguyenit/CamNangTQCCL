---
// Trang chi tiết Đội chuẩn dùng chung cho bản Việt (`/doi-chuan/<seg>/`) và bản Trung (`/zh/doi-chuan/<seg>/`).
// Props (tiêu đề, dòng phạm vi, thứ hạng) do src/lib/team-detail-pages.ts tính theo ngôn ngữ.
import SiteLayout from '../../layouts/SiteLayout.astro';
import { familyReturnHref } from '../../../js/team-detail-navigation.js';
import { pick } from '../../../js/i18n.js';
import type { RecommendedDetailProps } from '../../lib/team-detail-pages';
import type { SiteLocale } from '../../lib/locale-routes';

type Props = RecommendedDetailProps & { locale: SiteLocale };

const {entry, title, ordinal, scopeLine, generationId, manifestSha256, legacyTeamsSha256, lookupLinks, locale} = Astro.props;
const t = (vi: string, zh: string): string => pick(locale, vi, zh);
// Canonical bỏ query/hash: mọi biến thể deep-link vẫn trỏ về đúng một URL chi tiết.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const qualifier = [entry.sourceSeasonCode, ordinal > 1 ? String(ordinal) : null].filter(Boolean).join(' · ');
const pageLabel = qualifier ? `${title} (${qualifier})` : title;
const describedName = ordinal > 1 ? `${title} (${ordinal})` : title;
const hasScore = entry.value != null;
// Nhãn tier như js/recommended-reference-state.js (`sourceTierLabel`): đội chức năng có nhãn riêng.
const tier = entry.tierRaw
  ? (entry.tierRaw === 'FUNC' || entry.tierRaw === '功能隊' ? t('Đội chức năng', '功能队') : entry.tierRaw)
  : null;
const fallbackReturn = familyReturnHref('recommended', { sourceSeasonId: entry.sourceSeasonId, locale });
// JSON nhúng trong <script>: chặn `<` để chuỗi dữ liệu không đóng thẻ sớm.
const lookupLinksJson = JSON.stringify(lookupLinks).replace(/</g, '\\u003c');
---
<SiteLayout
  title={`${pageLabel}${t(' — Đội chuẩn — Cẩm Nang Game Tam Quốc Chí - Chiến Lược', ' — 推荐阵容 — 三国志战略版攻略手册')}`}
  description={locale === 'zh'
    ? `${describedName}阵容详情${scopeLine ? `（${scopeLine}）` : ''}：武将、战法、兵书与参考评分。`
    : `Chi tiết đội hình ${describedName}${scopeLine ? ` (${scopeLine})` : ''}: tướng, chiến pháp, binh thư và điểm tham khảo.`}
  pageKind="detail"
  activeSection="team-chuan"
  tagline={t('Chi tiết đội chuẩn', '推荐阵容详情')}
  canonicalUrl={canonicalUrl}
  ogType="article"
  locale={locale}
>
  <nav class="detail-back-row" aria-label={t('Quay lại danh sách đội', '返回阵容列表')}>
    <a id="team-return-link" class="detail-link detail-back-link" href={fallbackReturn} data-family-href={fallbackReturn}>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="11 6 5 12 11 18"></polyline></svg>
      {t('Quay lại đội chuẩn', '返回推荐阵容')}
    </a>
  </nav>

  <article
    id="team-detail-root"
    class="reference-detail"
    aria-labelledby="team-detail-title"
    aria-busy="true"
    data-family="recommended"
    data-source-config-id={entry.sourceConfigId}
    data-scope-key={entry.safeScopeKey}
    data-generation-id={generationId}
    data-manifest-sha256={manifestSha256}
    data-legacy-teams-sha256={legacyTeamsSha256}
  >
    <div class="detail-header">
      <div class="detail-head-main">
        {scopeLine ? <p class="scope-note detail-kicker">{scopeLine}</p> : null}
        <h1 id="team-detail-title" class="detail-title">{title}</h1>
        <div class="detail-meta-row">
          {tier ? (
            <span class="detail-tier" title="Tier">
              <span class="detail-tier-label">Tier</span>
              <span class="detail-tier-value">{tier}</span>
            </span>
          ) : null}
          <!-- Huy hiệu phe/loại binh do js/team-detail.js gắn từ bản ghi đã xác minh. -->
          <div id="team-detail-badges" class="detail-badges" hidden></div>
        </div>
      </div>
      <div id="team-detail-panel" class="detail-score-panel">
        {hasScore ? (
          <p class="detail-panel-label">
            <span class="detail-panel-kicker">{t('Điểm', '评分')}</span>
            <span class="detail-panel-note">{t('tổng hợp', '汇总')}</span>
          </p>
        ) : null}
        <p class="detail-score">
          {hasScore ? <><span class="detail-score-value">{entry.value}</span> <span class="detail-score-unit">{t('điểm', '分')}</span></> : t('Chưa có điểm', '暂无评分')}
        </p>
        <!-- Nút sao chép liên kết do js/team-detail.js gắn; trang đội chuẩn không dẫn link ra ngoài. -->
        <div id="team-detail-actions" class="detail-panel-actions"></div>
      </div>
    </div>

    <div id="team-detail-status" class="detail-state" role="status" aria-live="polite" aria-atomic="true">{t('Đang tải chi tiết…', '正在加载详情…')}</div>
    <noscript>
      <p class="scope-note">{t(
        'Trang chi tiết cần JavaScript để đọc dữ liệu đã xác minh. Bạn vẫn có thể quay lại danh sách đội chuẩn bằng liên kết phía trên.',
        '详情页需要 JavaScript 才能读取已验证的数据。你仍可通过上方链接返回推荐阵容列表。',
      )}</p>
    </noscript>
    <div id="team-detail-body" hidden></div>
  </article>

  <!-- Chiến báo thực chiến + bình luận do js/community-page.js dựng; dịch vụ cộng đồng lỗi thì chỉ khối này báo. -->
  <section id="community-root" class="cm-root"></section>

  <script is:inline type="application/json" id="team-lookup-links" set:html={lookupLinksJson}></script>
  <script is:inline type="module" src="/js/team-detail.js" slot="scripts"></script>
  <script is:inline type="module" src="/js/community-page.js" slot="scripts"></script>
</SiteLayout>
