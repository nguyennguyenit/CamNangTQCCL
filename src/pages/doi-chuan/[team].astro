---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { teamDetailCatalog } from '../../lib/team-detail-routes';
import { familyReturnHref } from '../../../js/team-detail-navigation.js';

export const prerender = true;

export async function getStaticPaths() {
  const catalog = await teamDetailCatalog();
  return catalog.recommended.map((entry) => ({
    params: {team: entry.routeSegment},
    props: {entry, generationId: catalog.generationId, manifestSha256: catalog.manifestSha256, legacyTeamsSha256: catalog.legacyTeamsSha256},
  }));
}

const {entry, generationId, manifestSha256, legacyTeamsSha256} = Astro.props;
// Canonical bỏ query/hash: mọi biến thể deep-link vẫn trỏ về đúng một URL chi tiết.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const title = entry.displayNameVi || 'Nội dung tiếng Việt chưa sẵn sàng';
const scopeLine = [entry.sourceSeasonCode, entry.sourceSeasonNameVi, entry.sourceCategoryNameVi]
  .filter(Boolean)
  .join(' · ');
const score = entry.value == null ? 'Chưa có điểm nguồn' : `${entry.value} điểm`;
const fallbackReturn = familyReturnHref('recommended', {
  sourceSeasonId: entry.sourceSeasonId,
  sourceCategoryId: entry.sourceCategoryId,
});
---
<SiteLayout
  title={`${title} — Đội chuẩn — Cẩm Nang Game Tam Quốc Chí - Chiến Lược`}
  description={`Chi tiết đội hình ${title} theo dữ liệu nguồn SGSDeck Recommended${scopeLine ? ` (${scopeLine})` : ''}.`}
  pageKind="detail"
  activeSection="team-chuan"
  tagline="Chi tiết đội chuẩn"
  canonicalUrl={canonicalUrl}
  ogType="article"
>
  <nav class="detail-back-row" aria-label="Quay lại danh sách đội">
    <a id="team-return-link" class="detail-link" href={fallbackReturn} data-family-href={fallbackReturn}>Quay lại đội chuẩn</a>
  </nav>

  <article
    id="team-detail-root"
    class="season-config-detail reference-detail"
    aria-labelledby="team-detail-title"
    aria-busy="true"
    data-family="recommended"
    data-source-config-id={entry.sourceConfigId}
    data-scope-key={entry.safeScopeKey}
    data-generation-id={generationId}
    data-manifest-sha256={manifestSha256}
    data-legacy-teams-sha256={legacyTeamsSha256}
  >
    <div class="detail-header">
      <div>
        <h1 id="team-detail-title" class="detail-title">{title}</h1>
        {scopeLine ? <p class="scope-note">{scopeLine}</p> : null}
      </div>
      <p class="detail-score">{score}</p>
    </div>

    <div id="team-detail-status" class="detail-state" role="status" aria-live="polite" aria-atomic="true">Đang tải chi tiết…</div>
    <noscript>
      <p class="scope-note">Trang chi tiết cần JavaScript để đọc dữ liệu nguồn đã xác minh. Bạn vẫn có thể quay lại danh sách đội chuẩn bằng liên kết phía trên.</p>
    </noscript>
    <div id="team-detail-body" hidden></div>
  </article>

  <script is:inline type="module" src="/js/team-detail.js" slot="scripts"></script>
</SiteLayout>
