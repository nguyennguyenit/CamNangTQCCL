---
import SiteLayout from '../../layouts/SiteLayout.astro';
const canonicalUrl = new URL('/khai-hoang/', Astro.site);
---
<SiteLayout
  title="Khai hoang — Cẩm Nang Game Tam Quốc Chí - Chiến Lược"
  description="Hướng dẫn khai hoang theo từng đội: build trước và sau, thanh điểm mốc và cách đánh đất."
  pageKind="section"
  activeSection="khaihoang"
  canonicalUrl={canonicalUrl}
>
  <section id="section-khaihoang" class="section active"></section>

  <script is:inline type="module" src="/js/app.js" slot="scripts"></script>
</SiteLayout>
