---
import SiteLayout from '../layouts/SiteLayout.astro';
import { seasonArtifactHashes } from '../lib/root-static-artifacts';
import { recommendedPublicationSnapshot } from '../lib/recommended-reference-artifacts';
const seasonHashes = await seasonArtifactHashes();
const recommended = await recommendedPublicationSnapshot();
---
<SiteLayout
  title="Cẩm Nang Game Tam Quốc Chí - Chiến Lược"
  description="Tổng hợp meta team, đội hình Cùng Tồn và Khai hoang game Tam Quốc Chí Chiến Lược, có đầy đủ bộ lọc theo tướng, chiến pháp, binh thư, tier."
  pageKind="root"
>
  <p slot="notice" class="disclaimer">Dữ liệu tổng hợp từ chia sẻ kinh nghiệm người chơi, mang tính tham khảo — không phải phương án duy nhất.</p>

  <div id="season-controls" class="season-controls" aria-label="Phạm vi đội hình"></div>
  <section id="section-team-chuan" class="section active"></section>
  <section id="section-team-khac" class="section"></section>
  <section id="section-coexist" class="section"></section>
  <section id="section-khaihoang" class="section"></section>
  <section id="section-heroes" class="section"></section>
  <section id="section-tactics" class="section"></section>
  <section id="section-recruit-tracker" class="section"></section>
  <section id="section-analyze" class="section"></section>
  <section id="section-roster-recommend" class="section"></section>

  <Fragment slot="scripts">
    <script is:inline type="application/json" id="season-artifact-hashes" set:html={JSON.stringify(seasonHashes)}></script>
    <script is:inline type="application/json" id="recommended-publication" set:html={JSON.stringify(recommended.pin)}></script>
    <script is:inline type="module" src="/js/app.js"></script>
  </Fragment>
</SiteLayout>
