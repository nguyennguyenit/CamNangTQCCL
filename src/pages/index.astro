---
import SiteLayout from '../layouts/SiteLayout.astro';
import { resolveLegacyRoute } from '../../js/legacy-routes.js';

const canonicalUrl = new URL('/', Astro.site);
const SECTIONS = [
  {id: 'team-chuan', label: 'Đội chuẩn', path: '/doi-chuan/'},
  {id: 'team-khac', label: 'Đội khác', path: '/doi-khac/'},
  {id: 'coexist', label: 'Cùng Tồn', path: '/cung-ton/'},
  {id: 'khaihoang', label: 'Khai hoang', path: '/khai-hoang/'},
  {id: 'lookup', label: 'Tra cứu', path: '/tra-cuu/'},
  {id: 'recruit-tracker', label: 'Theo dõi chiêu mộ', path: '/chieu-mo/', beta: true},
  {id: 'analyze', label: 'Soi đội từ ảnh', path: '/soi-doi/', beta: true},
  {id: 'roster-recommend', label: 'Gợi ý đội từ kho', path: '/goi-y-doi/', beta: true},
];
// Hash cũ phải chuyển trước khi vẽ trang: nhúng nguyên hàm thuần của js/legacy-routes.js vào một
// script inline chặn trong <head>. Listener `hashchange` phủ trường hợp dán link cũ khi đang ở `/`.
const redirectSource = `(function(){var resolve=${resolveLegacyRoute.toString()};var go=function(){var target=resolve(window.location.href,window.location.origin);if(target)window.location.replace(target);};go();window.addEventListener('hashchange',go);})();`;
---
<SiteLayout
  title="Cẩm Nang Game Tam Quốc Chí - Chiến Lược"
  description="Tổng hợp đội hình meta, đội hình Cùng Tồn và Khai hoang game Tam Quốc Chí Chiến Lược, có đầy đủ bộ lọc theo tướng, chiến pháp, binh thư, bậc."
  pageKind="landing"
  canonicalUrl={canonicalUrl}
>
  <script is:inline id="legacy-route-redirect" slot="head" set:html={redirectSource}></script>

  <p class="disclaimer">Dữ liệu tổng hợp từ chia sẻ kinh nghiệm người chơi, mang tính tham khảo — không phải phương án duy nhất.</p>

  <section id="landing-quick" aria-labelledby="landing-quick-title">
    <p class="section-intro-title">Lối vào nhanh</p>
    <h2 id="landing-quick-title">Bạn đang cần gì?</h2>
    <p class="section-intro-sub">Ba câu hỏi người chơi hay tìm nhất, mỗi câu dẫn thẳng tới đúng mục.</p>
    <ul class="landing-cards">
      <li>
        <a href="/doi-chuan/">Mùa này chơi đội nào? — Mở Đội chuẩn</a>
        <p>Lọc theo mùa, loại binh và phe. Xem dạng thẻ để đọc kỹ, hoặc dạng bảng để so nhanh.</p>
      </li>
      <li>
        <a href="/goi-y-doi/">Có sẵn tướng này thì ghép gì? — Gợi ý đội từ kho</a>
        <p>Chụp màn hình kho tướng và chiến pháp. Công cụ chọn tối đa 5 đội không trùng tài nguyên.</p>
      </li>
      <li>
        <a href="/tra-cuu/">Tướng, chiến pháp này làm gì? — Tra cứu</a>
        <p>Gõ tên Việt, Hán-Việt hay chữ Hán. Xem chỉ số, thích tính binh chủng và hiệu quả chiến pháp.</p>
      </li>
    </ul>

    <h3>Tất cả mục</h3>
    <ul class="landing-sections">
      {SECTIONS.map((section) => (
        <li><a href={section.path}>{section.label}{section.beta ? <span class="badge beta">Beta</span> : null}</a></li>
      ))}
    </ul>
  </section>
</SiteLayout>
