---
import CommunityTeamPage from '../../../components/pages/CommunityTeamPage.astro';
import { loadCommunityTeams } from '../../../lib/community-teams.ts';

export const prerender = true;

// Cùng tập đội với bản Việt: mỗi đội có đủ cặp vi/zh dù văn bản gốc bằng tiếng nào.
export async function getStaticPaths() {
  return (await loadCommunityTeams()).map((team) => ({ params: {id: team.id}, props: {team} }));
}

const {team} = Astro.props;
---
<CommunityTeamPage team={team} locale="zh" />
