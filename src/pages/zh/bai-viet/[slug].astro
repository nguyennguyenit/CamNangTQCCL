---
import BlogArticle from '../../../components/blog/BlogArticle.astro';
import { postsForLocale } from '../../../lib/blog-posts.ts';

export const prerender = true;

// Chỉ bài tiếng Trung; bài tiếng Việt sinh ở /bai-viet/<slug>/.
export async function getStaticPaths() {
  return (await postsForLocale('zh')).map((post) => ({ params: {slug: post.slug}, props: {post} }));
}

const {post} = Astro.props;
---
<BlogArticle post={post} />
