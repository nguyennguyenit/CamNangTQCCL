import SealMark from '../components/SealMark.astro';
import BrandName from '../components/BrandName.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import {
  COMMUNITY_LINKS,
  STATS_HREF,
  DOWNLOAD_HREF,
  DOWNLOAD_LINKS,
  EXTERNAL_REL,
  OFFICIAL_LINKS,
  localizedLinkDescription,
  localizedLinkLabel,
