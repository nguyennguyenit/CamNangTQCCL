  lookup: t('Xem tướng, chiến pháp, trang bị, quân sư', '查看武将、战法、装备、军师', '武将・戦法・装備・軍師を確認'),
  'recruit-tracker': t('Mốc bảo hiểm 5★, nhiều tài khoản', '5★ 保底进度，支持多账号', '★5 天井の進捗、複数アカウント対応'),
  analyze: t('Đọc đội từ ảnh chụp màn hình', '从截图识别阵容', 'スクリーンショットから編成を読み取り'),
  'roster-recommend': t('Tối đa 5 đội không trùng tài nguyên', '最多 5 队，武将战法不冲突', '最大 5 部隊、武将と戦法が重複しない'),
};
