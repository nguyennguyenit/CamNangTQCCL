---
import { seasonArtifactHashes, websiteDisplayPublicationSnapshot } from '../lib/root-static-artifacts';
import { teamDetailCatalog } from '../lib/team-detail-routes';
// Vỏ trang dùng chung: Landing, 8 trang mục và các trang chi tiết đều đi qua đây nên phần đầu
// trang chỉ tồn tại một bản. Trang mục khai `data-page-section` để js/app.js biết mục cần mount.
interface Props {
  title: string;
  description: string;
  pageKind: 'landing' | 'section' | 'detail' | 'not-found';
  activeSection?: 'team-chuan' | 'team-khac' | 'coexist' | 'khaihoang' | 'lookup' | 'recruit-tracker' | 'analyze' | 'roster-recommend' | null;
  tagline?: string;
  canonicalUrl?: URL | string;
  ogType?: 'website' | 'article';
  robots?: string;
}

const {
  title,
  description,
  pageKind,
  activeSection = null,
  tagline = 'Tất cả — tham khảo',
  canonicalUrl,
  ogType = 'website',
  robots,
} = Astro.props;

// Chỉ trang có URL công khai ổn định mới khai canonical; 404 cố ý bỏ trống cả canonical lẫn og:url.
const canonicalHref = canonicalUrl ? new URL(canonicalUrl).href : null;

const BRAND = 'Cẩm Nang Game Tam Quốc Chí - Chiến Lược';
const SECTIONS = [
  {id: 'team-chuan', label: 'Đội chuẩn', path: '/doi-chuan/'},
  {id: 'team-khac', label: 'Đội khác', path: '/doi-khac/'},
  {id: 'coexist', label: 'Cùng Tồn', path: '/cung-ton/'},
  {id: 'khaihoang', label: 'Khai hoang', path: '/khai-hoang/'},
  {id: 'lookup', label: 'Tra cứu', path: '/tra-cuu/'},
  {id: 'recruit-tracker', label: 'Theo dõi chiêu mộ', path: '/chieu-mo/', beta: true},
  {id: 'analyze', label: 'Soi đội từ ảnh', path: '/soi-doi/', beta: true},
  {id: 'roster-recommend', label: 'Gợi ý đội từ kho', path: '/goi-y-doi/', beta: true},
];
/** Mục có phạm vi mùa + chi tiết cấu hình: chỉ 5 trang này cần hai payload bên dưới. */
const SEASON_SECTIONS = ['team-chuan', 'team-khac', 'coexist', 'analyze', 'roster-recommend'];
// `:root` không đặt sẵn data-theme: script inline dưới đây quyết định trước khi stylesheet chạy.
const pageSection = pageKind === 'section' ? activeSection : null;
const seasonScope = pageSection !== null && SEASON_SECTIONS.includes(pageSection);
const contentClass = pageKind === 'detail' ? 'content detail-content' : 'content';
const website = await websiteDisplayPublicationSnapshot();
const seasonHashes = seasonScope ? await seasonArtifactHashes() : null;
// Bảng route handle: `{r,l,k}` cho mọi trang mục, chỉ `{l}` cho trang chi tiết (≈4.9 KB).
const routeHandles = pageKind === 'landing' || pageKind === 'not-found'
  ? null
  : await teamDetailCatalog().then((catalog) => {
      const legacy = Object.fromEntries(catalog.legacy.map((entry) => [entry.legacyTeamId, entry.routeSegment]));
      if (pageKind === 'detail') return {l: legacy};
      return {
        r: Object.fromEntries(catalog.recommended.map((entry) => [entry.sourceConfigId, entry.routeSegment])),
        l: legacy,
        k: Object.fromEntries(catalog.khaiHoang.map((entry) => [entry.khaiHoangTeamId, entry.handle])),
      };
    });
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalHref ? <link rel="canonical" href={canonicalHref} /> : null}
    {robots ? <meta name="robots" content={robots} /> : null}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonicalHref ? <meta property="og:url" content={canonicalHref} /> : null}
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png" />
    <slot name="head" />
    <script is:inline>
      // Đặt theme trước stylesheet để trang tối không nháy sáng; lỗi storage về theo hệ điều hành.
      (function () {
        var theme = 'light';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') theme = stored;
          else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
        } catch (error) {
          try {
            if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
          } catch (ignored) {
            theme = 'light';
          }
        }
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="preload" href="/fonts/be-vietnam-pro-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/noto-serif-display-700-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body data-page-section={pageSection}>
    <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>
    <div class="top-header">
      <header class="site-header">
        <div class="brand">
          <button id="section-menu-toggle" class="section-menu-toggle" type="button" aria-controls="section-menu-items" aria-expanded="false" aria-label="Mở menu trang" data-label-mode="icon">☰</button>
          <div>
            {pageKind === 'landing'
              ? <h1 class="site-title">{BRAND}</h1>
              : <a class="site-title" href="/">{BRAND}</a>}
            <p class="tagline">{tagline}</p>
          </div>
        </div>
        <div class="header-actions">
          <button id="theme-toggle" class="icon-btn" type="button" title="Đổi giao diện sáng/tối" aria-label="Chuyển sang giao diện tối" aria-pressed="false">🌗</button>
        </div>
      </header>

      <nav class="section-nav" aria-label="Chuyên mục">
        <div id="section-menu-items" class="section-menu-items">
          {SECTIONS.map((section) => (
            <a
              class:list={['nav-tab', {active: section.id === activeSection}]}
              data-section={section.id}
              href={section.path}
              aria-current={section.id === activeSection ? 'page' : null}
            >{section.label}{section.beta ? <span class="badge beta">Beta</span> : null}</a>
          ))}
        </div>
      </nav>
    </div>

    <slot name="notice" />

    <main id="main-content" class="layout">
      <div class={contentClass}>
        {seasonScope ? <div id="season-controls" class="season-controls" aria-label="Phạm vi đội hình"></div> : null}
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <p class="credit">Được xây dựng bởi <strong>Nguyễn Nguyên</strong> · HLxThanos · Đội 2 bang Huynh Đệ</p>
    </footer>

    <script is:inline type="application/json" id="recommended-publication" set:html={JSON.stringify(website.recommended.pin)}></script>
    <script is:inline type="application/json" id="website-display-publication" set:html={JSON.stringify(website.pin)}></script>
    {seasonHashes && <script is:inline type="application/json" id="season-artifact-hashes" set:html={JSON.stringify(seasonHashes)}></script>}
    {routeHandles && <script is:inline type="application/json" id="team-route-handles" set:html={JSON.stringify(routeHandles)}></script>}
    <script is:inline type="module">
      import { initSiteChrome } from '/js/site-chrome.js';
      initSiteChrome();
    </script>
    <slot name="scripts" />
  </body>
</html>
