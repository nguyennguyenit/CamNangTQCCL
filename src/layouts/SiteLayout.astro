} from '../lib/official-links';
import { POLICY_PAGES } from '../lib/policy-pages';
import { SECTION_ICONS, type SectionIcon } from '../lib/section-icons';
import { lookupGroupLinks, lookupJaPin, lookupRouteHandles, type LookupGroup } from '../lib/lookup-pages';
import { tacticDisplayTable } from '../lib/tactic-display';
import { LOCALE_OG, localeFromPath, localePath, pick, stripLocale } from '../../js/i18n.js';
import { FEEDBACK_KINDS } from '../../js/feedback-kinds.js';
import { HREFLANG, LOCALE_LABEL, SITE_LOCALES, alternatePaths, languageSwitchAria, mirroredAlternates, switchTargets, type SiteLocale } from '../lib/locale-routes';
// Cầu chuyển domain: script inline ĐẦU TIÊN của <head>, chạy trước mọi script đọc hash/storage.
import { HOST_BRIDGE_SCRIPT } from '../lib/host-bridge';
// Google Analytics 4 + Consent Mode v2: script inline thứ HAI của <head> (ngay sau cầu chuyển domain); trang quản trị tắt bằng `analytics={false}`.
import { ANALYTICS_LOADER_SCRIPT } from '../lib/analytics-loader';
// Vỏ trang dùng chung: Landing, 8 trang mục và các trang chi tiết đều đi qua đây nên phần đầu
// trang chỉ tồn tại một bản. Trang mục khai `data-page-section` để js/app.js biết mục cần mount.
// Mọi trang dùng một bộ menu thả; trang con có thêm cột chuyển nhanh nổi ở mép phải (một chạm tới các mục).
// Menu thả và menu mobile do `js/site-nav.js` điều khiển; chữ hiển thị khai obligation `authored-vi`.
// Đa ngôn ngữ: mọi chữ chọn đúng một ngôn ngữ qua `pick(locale, vi, zh, …)` (thứ tự `SITE_LOCALES`), mọi link nội bộ
// qua `localePath`; mỗi bản (`/zh/…`) có `<html lang>` riêng, hreflang tới mọi bản khác và một nhóm chuyển ngôn ngữ có đủ mọi bản.
interface Props {
  title: string;
  description: string;
  pageKind: 'landing' | 'section' | 'detail' | 'not-found';
  activeSection?: 'team-chuan' | 'team-khac' | 'coexist' | 'khaihoang' | 'lookup' | 'recruit-tracker' | 'analyze' | 'roster-recommend' | null;
  /** Chỉ trang chi tiết và 404: trang mục lấy mô tả của chính mục, Landing không có tagline. */
  tagline?: string;
  canonicalUrl?: URL | string;
  ogType?: 'website' | 'article';
  robots?: string;
  /** Ngôn ngữ trang; mặc định suy từ pathname (`/zh/…` → `zh`). */
  locale?: SiteLocale;
  /**
   * Khai bộ hreflang của mọi locale + x-default. Mặc định bật (mọi route đều có bản gương cùng đường dẫn dưới tiền tố
   * của từng locale); 404 và bài viết không có bản dịch tắt đi (`false`); bài viết có bản dịch khác slug truyền
   * đường dẫn theo locale (chỉ các bản có thật).
   */
  alternates?: boolean | Partial<Record<SiteLocale, string>>;
  /**
   * Đích của link chuyển ngôn ngữ, theo locale (kể cả locale trang, link `aria-current`); mặc định là bản gương của
   * pathname hiện tại. Một chuỗi đứng riêng là đường dẫn của đúng locale suy từ chính nó (`/zh/` → đích `zh`).
   */
  counterpartPath?: string | Partial<Record<SiteLocale, string>>;
  /** Ảnh OG tuyệt đối (ảnh bìa bài viết); vắng thì dùng `/og-image.png` 1200×630. */
  ogImage?: string;
  /** Trang nhóm Tra cứu (`/tra-cuu/<slug>/`): nhóm đang xem, gắn vào `<body data-lookup-group>` cho js/app.js. */
  lookupGroup?: LookupGroup;
  /**
   * Bật Google Analytics 4 và thanh đồng ý (mặc định bật): script `<head>`, thanh đồng ý, nút "Cài đặt cookie" ở footer và
   * `js/consent-banner.js`. Trang quản trị truyền `false` nên HTML của chúng không có dấu vết gtag nào. Host ngoài domain
   * chính (localhost, *.pages.dev, bản build test) nhận cùng HTML nhưng script tự không dựng gì (src/lib/analytics-loader.ts).
   */
  analytics?: boolean;
}

const {
  title,
  description,
  pageKind,
  activeSection = null,
  tagline,
  canonicalUrl,
  ogType = 'website',
  robots,
  ogImage,
  lookupGroup,
  analytics = true,
} = Astro.props;
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = (...variants: string[]): string => pick(locale, ...variants);
const href = (path: string): string => localePath(path, locale);
/** Chữ của bản ghi theo locale (`{vi, zh, …}` của POLICY_PAGES, FEEDBACK_KINDS); thiếu bản của locale trang thì build lỗi. */
const inLocale = (record: Readonly<Partial<Record<SiteLocale, string>>>): string => {
  const value = record[locale];
  if (typeof value !== 'string') throw new Error(`SiteLayout: bản ghi thiếu chữ cho locale "${locale}"`);
  return value;
};
const counterpartProp = Astro.props.counterpartPath;
const counterpartPaths: Partial<Record<SiteLocale, string>> = typeof counterpartProp === 'string'
  ? {[localeFromPath(counterpartProp)]: counterpartProp}
  : counterpartProp ?? {};
const alternatesProp = Astro.props.alternates ?? pageKind !== 'not-found';
const alternateLinks = (typeof alternatesProp === 'object'
  ? alternatePaths(alternatesProp)
  : alternatesProp ? mirroredAlternates(Astro.url.pathname) : []
).map((link) => ({hreflang: link.hreflang, href: new URL(link.path, Astro.site).href}));

// Chỉ trang có URL công khai ổn định mới khai canonical; 404 cố ý bỏ trống cả canonical lẫn og:url.
const canonicalHref = canonicalUrl ? new URL(canonicalUrl).href : null;

const LOGO_TITLE = t('Cẩm Nang Game Tam Quốc Chí - Chiến Lược', '三国志战略版攻略手册', '三國志 真戦 攻略手帳');
const SECTIONS = [
  {id: 'team-chuan', label: t('Đội chuẩn', '推荐阵容', 'おすすめ編成'), path: '/doi-chuan/'},
  {id: 'team-khac', label: t('Đội khác', '其他阵容', 'その他の編成'), path: '/doi-khac/'},
  {id: 'coexist', label: t('Cùng Tồn', '共存阵容', '共存編成'), path: '/cung-ton/'},
  {id: 'khaihoang', label: t('Khai hoang', '开荒', '開拓'), path: '/khai-hoang/'},
  {id: 'lookup', label: t('Tra cứu', '图鉴查询', '図鑑検索'), path: '/tra-cuu/'},
  {id: 'recruit-tracker', label: t('Theo dõi chiêu mộ', '招募记录', '登用記録'), path: '/theo-doi-chieu-mo/', beta: true},
  {id: 'analyze', label: t('Soi đội từ ảnh', '截图识阵', 'スクショ編成解析'), path: '/soi-doi-tu-anh/', beta: true},
  {id: 'roster-recommend', label: t('Gợi ý đội từ kho', '武将库配队', '武将図鑑から編成提案'), path: '/goi-y-doi-tu-kho/', beta: true},
];
/** Mục có phạm vi mùa + chi tiết cấu hình: chỉ 3 trang này cần hai payload bên dưới. */
const SEASON_SECTIONS = ['team-chuan', 'team-khac', 'coexist'];
/** Mô tả một dòng cho mục menu (artboard LandingMenu · LandingMenuMobile). */
const SECTION_DESCRIPTIONS: Record<string, string> = {
  'team-chuan': t('Cấu hình đội theo từng mùa', '按赛季整理的阵容配置', 'シーズン別の編成構成'),
  'team-khac': t('Đội người chơi tổng hợp và đối chiếu', '玩家阵容汇总与对照', 'プレイヤー編成のまとめと比較'),
  coexist: t('Các nhóm đội dùng cùng lúc', '可同时使用的阵容组合', '同時に使える編成の組み合わせ'),
