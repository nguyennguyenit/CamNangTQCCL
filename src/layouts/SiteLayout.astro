---
import { lookupBookAliases, lookupBooksHash, seasonArtifactHashes, websiteDisplayPublicationSnapshot } from '../lib/root-static-artifacts';
import { teamDetailCatalog } from '../lib/team-detail-routes';
import { PRERENDERED_TEAM_SECTIONS } from '../lib/team-ssr';
import { buildDateVi } from '../lib/build-date';
import SealMark from '../components/SealMark.astro';
import BrandName from '../components/BrandName.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import {
  COMMUNITY_LINKS,
  STATS_HREF,
  DOWNLOAD_HREF,
  DOWNLOAD_LINKS,
  EXTERNAL_REL,
  OFFICIAL_LINKS,
  localizedLinkDescription,
  localizedLinkLabel,
  type SiteLink,
} from '../lib/official-links';
import { POLICY_PAGES } from '../lib/policy-pages';
import { SECTION_ICONS, type SectionIcon } from '../lib/section-icons';
import { lookupGroupLinks, lookupRouteHandles, type LookupGroup } from '../lib/lookup-pages';
import { tacticDisplayTable } from '../lib/tactic-display';
import { localeFromPath, localePath, pick, stripLocale } from '../../js/i18n.js';
import { FEEDBACK_KINDS } from '../../js/feedback-kinds.js';
import { HREFLANG, LOCALE_LABEL, alternatePaths, mirroredAlternates, otherLocale } from '../lib/locale-routes';
// Cầu chuyển domain: script inline ĐẦU TIÊN của <head>, chạy trước mọi script đọc hash/storage.
import { HOST_BRIDGE_SCRIPT } from '../lib/host-bridge';
// Vỏ trang dùng chung: Landing, 8 trang mục và các trang chi tiết đều đi qua đây nên phần đầu
// trang chỉ tồn tại một bản. Trang mục khai `data-page-section` để js/app.js biết mục cần mount.
// Mọi trang dùng một bộ menu thả; trang con có thêm cột chuyển nhanh nổi ở mép phải (một chạm tới các mục).
// Menu thả và menu mobile do `js/site-nav.js` điều khiển; chữ hiển thị khai obligation `authored-vi`.
// Song ngữ: mọi chữ chọn đúng một ngôn ngữ qua `pick(locale, vi, zh)`, mọi link nội bộ qua `localePath`;
// bản Trung (`/zh/…`) có `<html lang="zh-Hans">`, hreflang tới bản Việt và nút chuyển ngôn ngữ.
interface Props {
  title: string;
  description: string;
  pageKind: 'landing' | 'section' | 'detail' | 'not-found';
  activeSection?: 'team-chuan' | 'team-khac' | 'coexist' | 'khaihoang' | 'lookup' | 'recruit-tracker' | 'analyze' | 'roster-recommend' | null;
  /** Chỉ trang chi tiết và 404: trang mục lấy mô tả của chính mục, Landing không có tagline. */
  tagline?: string;
  canonicalUrl?: URL | string;
  ogType?: 'website' | 'article';
  robots?: string;
  /** Ngôn ngữ trang; mặc định suy từ pathname (`/zh/…` → `zh`). */
  locale?: 'vi' | 'zh';
  /**
   * Khai cặp hreflang vi/zh-Hans/x-default. Mặc định bật (mọi route đều có bản gương cùng đường dẫn dưới `/zh`);
   * 404 và bài viết không có bản dịch tắt đi (`false`); bài viết có bản dịch khác slug truyền cặp đường dẫn.
   */
  alternates?: boolean | {vi: string; zh: string};
  /** Đường dẫn bản ngôn ngữ còn lại cho nút chuyển ngôn ngữ; mặc định là bản gương của pathname hiện tại. */
  counterpartPath?: string;
  /** Ảnh OG tuyệt đối (ảnh bìa bài viết); vắng thì dùng `/og-image.png` 1200×630. */
  ogImage?: string;
  /** Trang nhóm Tra cứu (`/tra-cuu/<slug>/`): nhóm đang xem, gắn vào `<body data-lookup-group>` cho js/app.js. */
  lookupGroup?: LookupGroup;
}

const {
  title,
  description,
  pageKind,
  activeSection = null,
  tagline,
  canonicalUrl,
  ogType = 'website',
  robots,
  ogImage,
  lookupGroup,
} = Astro.props;
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = (vi: string, zh: string): string => pick(locale, vi, zh);
const href = (path: string): string => localePath(path, locale);
const switchLocale = otherLocale(locale);
const counterpartPath = Astro.props.counterpartPath ?? localePath(stripLocale(Astro.url.pathname), switchLocale);
const alternatesProp = Astro.props.alternates ?? pageKind !== 'not-found';
const alternateLinks = (typeof alternatesProp === 'object'
  ? alternatePaths(alternatesProp.vi, alternatesProp.zh)
  : alternatesProp ? mirroredAlternates(Astro.url.pathname) : []
).map((link) => ({hreflang: link.hreflang, href: new URL(link.path, Astro.site).href}));

// Chỉ trang có URL công khai ổn định mới khai canonical; 404 cố ý bỏ trống cả canonical lẫn og:url.
const canonicalHref = canonicalUrl ? new URL(canonicalUrl).href : null;

const LOGO_TITLE = t('Cẩm Nang Game Tam Quốc Chí - Chiến Lược', '三国志战略版攻略手册');
const SECTIONS = [
  {id: 'team-chuan', label: t('Đội chuẩn', '推荐阵容'), path: '/doi-chuan/'},
  {id: 'team-khac', label: t('Đội khác', '其他阵容'), path: '/doi-khac/'},
  {id: 'coexist', label: t('Cùng Tồn', '共存阵容'), path: '/cung-ton/'},
  {id: 'khaihoang', label: t('Khai hoang', '开荒'), path: '/khai-hoang/'},
  {id: 'lookup', label: t('Tra cứu', '图鉴查询'), path: '/tra-cuu/'},
  {id: 'recruit-tracker', label: t('Theo dõi chiêu mộ', '招募记录'), path: '/theo-doi-chieu-mo/', beta: true},
  {id: 'analyze', label: t('Soi đội từ ảnh', '截图识阵'), path: '/soi-doi-tu-anh/', beta: true},
  {id: 'roster-recommend', label: t('Gợi ý đội từ kho', '武将库配队'), path: '/goi-y-doi-tu-kho/', beta: true},
];
/** Mục có phạm vi mùa + chi tiết cấu hình: chỉ 3 trang này cần hai payload bên dưới. */
const SEASON_SECTIONS = ['team-chuan', 'team-khac', 'coexist'];
/** Mô tả một dòng cho mục menu (artboard LandingMenu · LandingMenuMobile). */
const SECTION_DESCRIPTIONS: Record<string, string> = {
  'team-chuan': t('Cấu hình đội theo từng mùa', '按赛季整理的阵容配置'),
  'team-khac': t('Đội người chơi tổng hợp và đối chiếu', '玩家阵容汇总与对照'),
  coexist: t('Các nhóm đội dùng cùng lúc', '可同时使用的阵容组合'),
  khaihoang: t('Hướng dẫn đánh đất theo từng đội', '按队伍整理的打地攻略'),
  lookup: t('Xem tướng, chiến pháp, trang bị, quân sư', '查看武将、战法、装备、军师'),
  'recruit-tracker': t('Mốc bảo hiểm 5★, nhiều tài khoản', '5★ 保底进度，支持多账号'),
  analyze: t('Đọc đội từ ảnh chụp màn hình', '从截图识别阵容'),
  'roster-recommend': t('Tối đa 5 đội không trùng tài nguyên', '最多 5 队，武将战法不冲突'),
};
/** Icon của từng mục trong menu mobile — cùng hình với lưới lối vào của Landing. */
const SECTION_ICON: Record<string, SectionIcon> = {
  'team-chuan': 'standard',
  'team-khac': 'other',
  coexist: 'coexist',
  khaihoang: 'khaihoang',
  lookup: 'lookup',
  'recruit-tracker': 'recruit',
  analyze: 'analyze',
  'roster-recommend': 'roster',
};
const QUICK_NAV_LABEL = t('Chuyển nhanh', '快速切换');
const FOOTER_INTRO = t(
  'Cẩm nang cộng đồng cho người chơi Tam Quốc Chí Chiến Lược: đội hình theo mùa, tra cứu tướng và chiến pháp, cùng vài công cụ tính giúp.',
  '面向《三国志·战略版》玩家的社区攻略手册：分赛季阵容、武将与战法查询，以及若干实用工具。',
);
const COPYRIGHT = t(
  '© 2026 Cẩm Nang TQCCL · Cẩm nang tra cứu build tướng dành cho game Tam Quốc Chí - Chiến Lược',
  '© 2026 三国志战略版攻略手册 · 《三国志·战略版》武将搭配查询手册',
);
/** Nhóm tác giả: tên người và tên bang giữ nguyên, chỉ phần mô tả ("Team 2 bang") theo ngôn ngữ trang. */
const CREDIT = t('Nguyễn Nguyên · HLxThanos · Team 2 bang Huynh Đệ', 'Nguyễn Nguyên · HLxThanos · Huynh Đệ 帮会二队');
const CREDIT_LABEL = t('Được xây dựng bởi', '制作');
const STATS_LABEL = t('Số liệu cẩm nang', '手册数据');
const STATS_DESCRIPTION = t('Quy mô dữ liệu của cẩm nang', '手册的数据规模');
const OPEN_GUIDE_LABEL = t('Mở cẩm nang', '打开手册');
const OPEN_GUIDE_MOBILE_LABEL = t('Mở Đội chuẩn', '打开推荐阵容');
const ABOUT_LABEL = t('Về cẩm nang', '关于手册');
const MENU_LABEL = t('Menu chính', '主菜单');
const MENU_DIALOG_LABEL = t('Menu', '菜单');
const MENU_OPEN_LABEL = t('Mở menu trang', '打开页面菜单');
const MENU_CLOSE_LABEL = t('Đóng menu', '关闭菜单');
const FIGURES_LABEL = t('Đội hình', '阵容');
const TOOLS_LABEL = t('Công cụ', '工具');
const TOOLS_TITLE = t('Công cụ · Beta', '工具 · Beta');
const GAME_LABEL = t('Game', '游戏');
const GAME_STRIP_TITLE = t('Game chính thức', '官方游戏');
const GAME_STRIP_SUBTITLE = t('Liên kết của nhà phát hành', '发行商链接');
const COMMUNITY_TITLE = t('Cộng đồng game', '游戏社区');
const DOWNLOAD_TITLE = t('Tải game', '下载游戏');
const GAME_LINKS_LABEL = t('Liên kết game', '游戏链接');
const UPDATED_LABEL = t('Dữ liệu cập nhật', '数据更新于');
const SKIP_LINK_LABEL = t('Bỏ qua điều hướng', '跳过导航');
const NEW_TAB_LABEL = t('(mở tab mới)', '(在新标签页打开)');
const SCOPE_GROUP_LABEL = t('Phạm vi đội hình', '阵容范围');
/** Nút đổi giao diện: tên nói hành động sẽ xảy ra (theo theme đang bật), không dùng `aria-pressed`. */
const THEME_TO_DARK_LABEL = t('Chuyển sang giao diện tối', '切换到深色模式');
const THEME_TO_LIGHT_LABEL = t('Chuyển sang giao diện sáng', '切换到浅色模式');
/** Nút chuyển ngôn ngữ: nhãn viết bằng ngôn ngữ đích, tên truy cập nói rõ hành động bằng ngôn ngữ trang. */
const SWITCH_LABEL = LOCALE_LABEL[switchLocale];
const SWITCH_ARIA = t('Xem bản tiếng Trung (中文)', '切换到越南语版本 (Tiếng Việt)');
/** Trang mục công cụ dựng nội dung bằng JavaScript: không có JS thì vẫn có tiêu đề mục và lời nhắn này (bốn mục đội và Tra cứu dựng sẵn nên không cần). */
const SECTION_NOSCRIPT_MESSAGE = t(
  'Mục này cần JavaScript để hiển thị nội dung. Hãy bật JavaScript rồi tải lại trang.',
  '此栏目需要 JavaScript 才能显示内容。请启用 JavaScript 后重新加载页面。',
);
const OG_IMAGE_PATH = '/og-image.png';
const COMMUNITY_SECTION_LABEL = pick(locale, 'Cộng đồng', '社区');
const DONATE_LABEL = pick(locale, 'Ủng hộ tác giả', '支持作者');
const DONATE_LEAD = pick(
  locale,
  'Cẩm nang miễn phí cho mọi người chơi. Nếu thấy hữu ích, bạn có thể ủng hộ tác giả qua mã QR dưới đây — cảm ơn bạn rất nhiều!',
  '本手册对所有玩家免费开放。如果觉得有帮助，欢迎扫描下方二维码支持作者——非常感谢！',
);
const DONATE_NOTE = pick(locale, 'Quét mã bằng ứng dụng thanh toán trên điện thoại.', '请使用手机上的支付应用扫码。');
const DONATE_QR_ALT = pick(locale, 'Mã QR ủng hộ tác giả Cẩm Nang TQCCL', '支持《三国志战略版攻略手册》作者的收款二维码');
const DONATE_CLOSE_LABEL = pick(locale, 'Đóng', '关闭');
const DONATE_QR_PATH = '/donate-qr.png';
const FEEDBACK_LABEL = t('Góp ý, sửa lỗi', '意见反馈');
const FEEDBACK_LEAD = t(
  'Báo lỗi, thông tin sai hoặc đề xuất tính năng. Để lại email nếu bạn muốn nhận phản hồi.',
  '报告错误、指出信息有误或提出功能建议。如需回复，请留下邮箱。',
);
const FEEDBACK_KIND_LABEL = t('Loại', '类型');
const FEEDBACK_TITLE_LABEL = t('Tiêu đề', '标题');
const FEEDBACK_BODY_LABEL = t('Nội dung', '内容');
const FEEDBACK_EMAIL_LABEL = t('Email (tuỳ chọn, để trả lời)', '邮箱（选填，用于回复）');
const FEEDBACK_SUBMIT_LABEL = t('Gửi góp ý', '提交反馈');

// `:root` không đặt sẵn data-theme: script inline dưới đây quyết định trước khi stylesheet chạy.
const pageSection = pageKind === 'section' ? activeSection : null;
const seasonScope = pageSection !== null && SEASON_SECTIONS.includes(pageSection);
/** Trang chi tiết và 404 dùng khung nội dung có lề trang (`main.layout:has(> .detail-content)`). */
const contentClass = pageKind === 'detail' || pageKind === 'not-found' ? 'content detail-content' : 'content';
/**
 * Mục đang xem: trang mục là chính nó (`page`), trang chi tiết chỉ thuộc mục cha (`true`, không phải
 * trang hiện tại) — khu vực được đánh dấu không phải tài liệu đang mở.
 */
const currentMark = (id: string | undefined | false | null) =>
  id && id === activeSection ? (pageKind === 'detail' ? 'true' : 'page') : null;
const website = await websiteDisplayPublicationSnapshot();
const seasonHashes = seasonScope ? await seasonArtifactHashes() : null;
// Trang nhóm Binh thư đọc `books-dict` (ngoài lookup manifest): pin byte ngay trên trang; tên Hán nguồn
// (phồn thể, tên cũ) từ bảng danh tính của pipeline nhúng kèm, `<` chặn để chuỗi không đóng thẻ sớm.
const booksPage = pageKind === 'section' && lookupGroup === 'books';
const booksHash = booksPage ? await lookupBooksHash() : null;
const bookAliasesJson = booksPage ? JSON.stringify(await lookupBookAliases()).replace(/</g, '\\u003c') : null;
// Ngày build `dd/mm/yyyy` (giờ Việt Nam); bản Trung viết theo thứ tự năm-tháng-ngày.
const updatedOn = locale === 'zh' ? buildDateVi().split('/').reverse().join('-') : buildDateVi();
const topSections = SECTIONS.slice(0, 5);
const toolSections = SECTIONS.slice(5);
const landing = pageKind === 'landing';
/** Tagline dưới logo: trang mục dùng đúng mô tả của mục trong menu; Landing không vẽ tagline.
 *  Bản vi đã có dòng phụ trong logo chữ nên không vẽ thêm tagline. */
const headerTagline = locale === 'vi' ? null : pageKind === 'section' && activeSection ? SECTION_DESCRIPTIONS[activeSection] : landing ? null : tagline;
const sectionLabel = pageKind === 'section' ? SECTIONS.find((section) => section.id === activeSection)?.label : null;
/** Menu thả không phải link: đánh dấu nút khi trang đang xem nằm trong nhóm của nó. */
const figuresActive = topSections.slice(0, 4).some((section) => section.id === activeSection);
const lookupActive = activeSection === 'lookup';
const toolsActive = toolSections.some((section) => section.id === activeSection);
const ogImageHref = ogImage ?? new URL(OG_IMAGE_PATH, Astro.site).href;
/**
 * Mục cộng đồng (Chiến báo, Đội cộng đồng, Bài viết): không phải trang mục của app.js nên không mang `id`/`data-section`;
 * mục đang xem suy từ pathname (bỏ tiền tố ngôn ngữ): đúng trang danh sách = `page`, trang con = `true`.
 */
const basePath = stripLocale(Astro.url.pathname);
const pathMark = (path: string) => (basePath === path ? 'page' : basePath.startsWith(path) ? 'true' : null);
const communityEntries: Entry[] = [
  {
    label: pick(locale, 'Chiến báo', '战报'),
    href: localePath('/chien-bao/', locale),
    description: pick(locale, 'Kết quả trận thật, AI phân tích, tỉ lệ thắng', '实战结果、AI 分析与胜率统计'),
    ariaCurrent: pathMark('/chien-bao/'),
    icon: 'report',
  },
  {
    label: pick(locale, 'Đội cộng đồng', '社区阵容'),
    href: localePath('/doi-cong-dong/', locale),
    description: pick(locale, 'Đội người chơi đăng, bình chọn và chiến báo', '玩家发布的阵容、投票与战报'),
    ariaCurrent: pathMark('/doi-cong-dong/'),
    icon: 'community',
  },
  {
    label: pick(locale, 'Bài viết', '文章'),
    href: localePath('/bai-viet/', locale),
    description: pick(locale, 'Phân tích meta và hướng dẫn mùa mới', '环境分析与新赛季指南'),
    ariaCurrent: pathMark('/bai-viet/'),
    icon: 'post',
  },
];
const communityActive = communityEntries.some((entry) => entry.ariaCurrent);
const communityMenuSection: MenuSection = {entries: communityEntries};
/** Nhóm "Về cẩm nang": số liệu trên Landing rồi các trang chính sách (src/lib/policy-pages.ts). */
const aboutEntries: Entry[] = [
  {label: STATS_LABEL, href: href(STATS_HREF), description: STATS_DESCRIPTION},
  ...POLICY_PAGES.map((page): Entry => ({
    label: pick(locale, page.label.vi, page.label.zh),
    href: href(page.path),
    description: pick(locale, page.description.vi, page.description.zh),
    ariaCurrent: pathMark(page.path),
  })),
];
const aboutActive = aboutEntries.some((entry) => entry.ariaCurrent);
/** Mục điều hướng; `data-section` chỉ đặt ở thanh chuyển nhanh để danh sách shell giữ đúng 8 mục. */
const sectionEntry = (section: (typeof SECTIONS)[number]): Entry => ({
  id: section.id,
  label: section.label,
  href: href(section.path),
  description: SECTION_DESCRIPTIONS[section.id],
  beta: Boolean(section.beta),
  icon: SECTION_ICON[section.id],
});
/** Bảy trang nhóm Tra cứu: mục đang xem đánh dấu theo pathname như các trang con khác. */
const lookupEntries: Entry[] = lookupGroupLinks(locale).map((entry) => ({
  label: entry.label,
  href: href(entry.path),
  description: entry.description,
  ariaCurrent: pathMark(entry.path),
}));
type Entry = {label: string; href: string; description?: string; id?: string; current?: boolean; ariaCurrent?: 'page' | 'true' | null; external?: boolean; offsite?: boolean; beta?: boolean; icon?: SectionIcon};
/** `layout` chỉ dùng ở menu mobile: ô lưới có icon, chip, dòng (icon tuỳ mục) hoặc lưới link gọn 2 cột. */
type MenuSection = {title?: string; titleHref?: string; titleCurrent?: boolean; titleBadge?: boolean; entries: Entry[]; twoColumn?: boolean; layout?: 'tiles' | 'chips' | 'rows' | 'links'};
/** `split`: panel 2 cột — nhóm đầu chiếm cột trái, các nhóm sau xếp chồng ở cột phải (menu Game). */
type Menu = {key: string; label: string; width: number; beta?: boolean; split?: boolean; active?: boolean; sections: MenuSection[]};
/** `external` = mở tab mới (http/https); `offsite` = đi khỏi site (http/https/mailto) nên cần chỉ báo ↗. */
const external = (group: SiteLink): Entry => ({
  label: localizedLinkLabel(group, locale),
  href: group.href,
  description: localizedLinkDescription(group, locale),
  external: group.external,
  offsite: group.external || group.href.startsWith('mailto:'),
});
/** Menu Game: link chính thức (kèm mô tả) bên trái; cộng đồng và tải game là dòng gọn chỉ có nhãn bên phải. */
const withoutDescription = (entry: Entry): Entry => ({...entry, description: undefined});
const gameMenuSections: MenuSection[] = [
  {title: GAME_STRIP_TITLE, entries: OFFICIAL_LINKS.map(external)},
  {title: COMMUNITY_TITLE, entries: COMMUNITY_LINKS.map(external).map(withoutDescription)},
  {title: DOWNLOAD_TITLE, entries: DOWNLOAD_LINKS.map(external).map(withoutDescription)},
];
/** Panel menu thả không lặp lại nhãn nút (nút đã ghi "Công cụ" + Beta); menu mobile tự đặt tiêu đề nhóm. */
const toolsMenuSection: MenuSection = {
  entries: toolSections.map(sectionEntry),
};
/** Menu thả desktop: một bộ duy nhất cho mọi trang (Landing, trang mục, chi tiết, 404). */
const menus: Menu[] = [
  {key: 'doi-hinh', label: FIGURES_LABEL, width: 320, active: figuresActive, sections: [{entries: topSections.slice(0, 4).map(sectionEntry)}]},
  {key: 'tra-cuu', label: SECTIONS[4].label, width: 520, active: lookupActive, sections: [{entries: lookupEntries, twoColumn: true}]},
  {key: 'cong-cu', label: TOOLS_LABEL, beta: true, width: 340, active: toolsActive, sections: [toolsMenuSection]},
  {key: 'cong-dong', label: COMMUNITY_SECTION_LABEL, width: 340, active: communityActive, sections: [communityMenuSection]},
  {key: 'game', label: GAME_LABEL, width: 560, split: true, sections: gameMenuSections},
  {key: 've-cam-nang', label: ABOUT_LABEL, width: 340, active: aboutActive, sections: [{entries: aboutEntries}]},
];
/**
 * Cột chuyển nhanh nổi ở mép phải (chỉ trang con): một chạm tới 8 mục của app và 2 trang cộng đồng.
 * `groupStart` vẽ vạch ngăn trước nhóm Công cụ và nhóm Cộng đồng.
 */
const quickEntries: (Entry & {groupStart?: boolean})[] = [
  ...topSections.map(sectionEntry),
  ...toolSections.map((section, index) => ({...sectionEntry(section), groupStart: index === 0})),
  ...communityEntries.map((entry, index) => ({...entry, groupStart: index === 0})),
];
/**
 * Menu mobile toàn màn hình: không mô tả; ô lưới cho Đội hình, chip cho Tra cứu, dòng có icon cho Công cụ và
 * Cộng đồng. "Về cẩm nang" và "Liên kết game" ít dùng hơn nên thu gọn (`<details>`), chỉ mở khi bấm —
 * trừ khi trang đang xem nằm trong nhóm đó.
 */
type MobileGroup = Omit<MenuSection, 'entries' | 'layout'> & {collapsible?: boolean; open?: boolean; sections: MenuSection[]};
const mobileGroupsSource: MobileGroup[] = [
  {title: FIGURES_LABEL, sections: [{entries: topSections.slice(0, 4).map(sectionEntry), layout: 'tiles'}]},
  {title: SECTIONS[4].label, titleHref: href(SECTIONS[4].path), titleCurrent: lookupActive, sections: [{entries: lookupEntries, layout: 'chips'}]},
  {title: TOOLS_LABEL, titleBadge: true, sections: [{entries: toolSections.map(sectionEntry), layout: 'rows'}]},
  {title: COMMUNITY_SECTION_LABEL, sections: [{entries: communityEntries, layout: 'rows'}]},
  {title: ABOUT_LABEL, collapsible: true, open: aboutActive, sections: [{entries: aboutEntries, layout: 'rows'}]},
  {
    title: GAME_LINKS_LABEL,
    collapsible: true,
    sections: [
      {title: GAME_STRIP_TITLE, entries: OFFICIAL_LINKS.map(external), layout: 'links'},
      {title: COMMUNITY_TITLE, entries: COMMUNITY_LINKS.map(external), layout: 'links'},
      {title: DOWNLOAD_TITLE, entries: DOWNLOAD_LINKS.map(external), layout: 'links'},
    ],
  },
];
const mobileGroups = mobileGroupsSource.map((group) => ({
  ...group,
  sections: group.sections.map((section) => ({...section, entries: section.entries.map(withoutDescription)})),
}));
const footerColumns: MenuSection[] = [
  {title: FIGURES_LABEL, entries: [sectionEntry(SECTIONS[0]), sectionEntry(SECTIONS[1]), sectionEntry(SECTIONS[2]), sectionEntry(SECTIONS[3])].map((entry) => ({...entry, description: undefined}))},
  {title: SECTIONS[4].label, titleHref: href(SECTIONS[4].path), entries: lookupEntries.map((entry) => ({...entry, description: undefined}))},
  {title: TOOLS_TITLE, entries: toolSections.map(sectionEntry).map((entry) => ({...entry, description: undefined, beta: undefined}))},
  {
    title: COMMUNITY_SECTION_LABEL,
    entries: [
      ...communityEntries.map((entry) => ({...entry, description: undefined})),
      {label: pick(locale, 'RSS bài viết', '文章 RSS'), href: localePath('/rss.xml', locale)},
    ],
  },
  {title: ABOUT_LABEL, entries: aboutEntries.map((entry) => ({...entry, description: undefined}))},
];
// Bảng route handle: `{r,l,k}` cho mọi trang mục, chỉ `{l}` cho trang chi tiết đội (≈4.9 KB). Trang riêng của mục Tra cứu
// (`detail` + `lookup`) không đọc bảng nào (link dựng sẵn lúc build) nên không nhúng.
const embedsRouteTables = !(pageKind === 'detail' && activeSection === 'lookup');
const routeHandles = pageKind === 'landing' || pageKind === 'not-found' || !embedsRouteTables
  ? null
  : await teamDetailCatalog().then((catalog) => {
      const legacy = Object.fromEntries(catalog.legacy.map((entry) => [entry.legacyTeamId, entry.routeSegment]));
      if (pageKind === 'detail') return {l: legacy};
      return {
        r: Object.fromEntries(catalog.recommended.map((entry) => [entry.sourceConfigId, entry.routeSegment])),
        l: legacy,
        k: Object.fromEntries(catalog.khaiHoang.map((entry) => [entry.khaiHoangTeamId, entry.handle])),
      };
    });
// Ngoại lệ slug trang riêng Tra cứu (hiện `{}`): mọi trang dựng link Tra cứu ở trình duyệt đăng ký lại cùng bảng với build.
const lookupRouteTable = routeHandles ? JSON.stringify(await lookupRouteHandles()) : null;
// Bảng tên chiến pháp hiển thị (bản Việt): trang có dữ liệu đội/Tra cứu dựng lại ở trình duyệt dùng cùng bảng với bản dựng sẵn.
const tacticDisplayJson = pageKind === 'landing' || pageKind === 'not-found' ? null : JSON.stringify(await tacticDisplayTable()).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={HREFLANG[locale]}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline id="host-bridge" set:html={HOST_BRIDGE_SCRIPT}></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalHref ? <link rel="canonical" href={canonicalHref} /> : null}
    {robots ? <meta name="robots" content={robots} /> : null}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonicalHref ? <meta property="og:url" content={canonicalHref} /> : null}
    <meta property="og:site_name" content={LOGO_TITLE} />
    <meta property="og:locale" content={t('vi_VN', 'zh_CN')} />
    <meta property="og:locale:alternate" content={t('zh_CN', 'vi_VN')} />
    {alternateLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    <meta property="og:image" content={ogImageHref} />
    {ogImage ? null : <meta property="og:image:width" content="1200" />}
    {ogImage ? null : <meta property="og:image:height" content="630" />}
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png" />
    <slot name="head" />
    <script is:inline>
      // Đặt theme trước stylesheet để trang tối không nháy sáng; lỗi storage về theo hệ điều hành.
      (function () {
        var theme = 'light';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') theme = stored;
          else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
        } catch (error) {
          try {
            if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
          } catch (ignored) {
            theme = 'light';
          }
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="preload" href="/fonts/be-vietnam-pro-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/noto-serif-display-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Chữ có dấu nằm ở subset vietnamese: tải sớm để chữ Việt không hiện font dự phòng rồi mới đổi.
         Bản Trung không có chữ Việt nên bỏ hai subset này (chữ Hán dùng font hệ thống, xem :lang(zh) trong CSS). -->
    {locale === 'vi' ? <link rel="preload" href="/fonts/be-vietnam-pro-400-vietnamese.woff2" as="font" type="font/woff2" crossorigin /> : null}
    {locale === 'vi' ? <link rel="preload" href="/fonts/noto-serif-display-700-vietnamese.woff2" as="font" type="font/woff2" crossorigin /> : null}
  </head>
  <body data-page-section={pageSection} data-lookup-group={lookupGroup}>
    <a class="skip-link" href="#main-content">{SKIP_LINK_LABEL}</a>
    <div class="top-header">
      <header class:list={['site-header', landing && 'site-header-landing']}>
        <button id="section-menu-toggle" class="site-menu-toggle" type="button" aria-controls="section-menu-items" aria-expanded="false" aria-label={MENU_OPEN_LABEL}>
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line></svg>
        </button>
        {landing
          ? <div class="brand"><span class="seal seal-header" aria-hidden="true"><SealMark /></span><span class="brand-text"><span class="site-title"><BrandName locale={locale} title={LOGO_TITLE} /></span></span></div>
          : <a class="brand" href={href('/')}><span class="seal seal-header" aria-hidden="true"><SealMark /></span><span class="brand-text"><span class="site-title"><BrandName locale={locale} title={LOGO_TITLE} /></span>{headerTagline ? <span class="tagline">{headerTagline}</span> : null}</span></a>}

        <nav class="site-nav" aria-label={MENU_LABEL}>
          <ul class="site-nav-list">
            {menus.map((menu) => (
              <li class:list={['nav-dropdown', menu.key === 'game' && 'nav-dropdown-game', menu.key === 've-cam-nang' && 'nav-dropdown-about']} data-dropdown>
                <button
                  id={`nav-toggle-${menu.key}`}
                  class:list={['nav-tab nav-tab-toggle', {active: menu.active}]}
                  type="button"
                  aria-expanded="false"
                  aria-controls={`nav-menu-${menu.key}`}
                  data-dropdown-button
                >{menu.label}{menu.beta ? <span class="badge-beta">Beta</span> : null}<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
                <div id={`nav-menu-${menu.key}`} class:list={['nav-menu', {'nav-menu-split': menu.split}]} style={`--nav-menu-width: ${menu.width}px`} data-dropdown-panel hidden>
                  {menu.sections.map((section) => (
                    <div class="nav-menu-section">
                      {section.title ? <p class="nav-menu-title">{section.title}</p> : null}
                      <ul class:list={['nav-menu-list', {columns: section.twoColumn}]}>
                        {section.entries.map((entry) => (
                          <li>
                            <a
                              class:list={['nav-menu-item', {active: entry.current || entry.ariaCurrent || entry.id === activeSection}]}
                              href={entry.href}
                              target={entry.external ? '_blank' : null}
                              rel={entry.external ? EXTERNAL_REL : null}
                              aria-current={currentMark(entry.id) ?? entry.ariaCurrent ?? null}
                            >
                              <span class="nav-menu-label">{entry.label}{entry.offsite ? <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6"></path><path d="M20 4l-9 9"></path><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path></svg> : null}</span>
                              {entry.description ? <span class="nav-menu-desc">{entry.description}</span> : null}
                              {entry.external ? <span class="visually-hidden">{NEW_TAB_LABEL}</span> : null}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </nav>

        <div class="header-actions">
          <!-- Chuyển ngôn ngữ: link thật tới bản gương của trang; js/site-chrome.js giữ lại query/hash hiện tại. -->
          <a class="lang-switch" href={counterpartPath} hreflang={HREFLANG[switchLocale]} lang={HREFLANG[switchLocale]} aria-label={SWITCH_ARIA} data-lang-switch>{SWITCH_LABEL}</a>
          <ThemeToggle id="theme-toggle" toDark={THEME_TO_DARK_LABEL} toLight={THEME_TO_LIGHT_LABEL} />
          <!-- Đăng nhập cộng đồng: js/community-auth.js dựng nút Đăng nhập hoặc ảnh đại diện + menu tài khoản. -->
          <div id="community-auth" class="cm-auth"></div>
          <script is:inline type="module" src="/js/community-auth.js"></script>
          {landing ? <a class="header-cta" href={href('/doi-chuan/')}>{OPEN_GUIDE_LABEL}</a> : null}
        </div>
      </header>
    </div>

    <!-- Thanh chuyển nhanh (chỉ trang con; Landing đã có lưới lối vào): cột icon nổi ở mép phải, rê chuột hiện
         tên trang; màn cảm ứng thu thành nút tròn góc dưới phải mở danh sách. Link thật tới 8 mục và 2 trang
         cộng đồng. Nút + danh sách dùng hợp đồng menu thả của js/site-nav.js; từ 821px CSS luôn hiện danh sách. -->
    {landing ? null : (
      <nav class="quick-nav" aria-label={QUICK_NAV_LABEL} data-dropdown>
        <button class="quick-nav-toggle" type="button" aria-expanded="false" aria-controls="quick-nav-panel" aria-label={QUICK_NAV_LABEL} data-dropdown-button>
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h14l-3.5-3.5"></path><path d="M20 16H6l3.5 3.5"></path></svg>
        </button>
        <ul id="quick-nav-panel" class="quick-nav-list" data-dropdown-panel hidden>
          {quickEntries.map((entry) => (
            <li class:list={['quick-nav-item', {'quick-nav-group-start': entry.groupStart}]}>
              <a
                class:list={['quick-nav-link', {active: entry.id ? entry.id === activeSection : entry.ariaCurrent}]}
                data-section={entry.id}
                href={entry.href}
                aria-current={currentMark(entry.id) ?? entry.ariaCurrent ?? null}
              >
                {entry.icon ? <span class="quick-nav-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={SECTION_ICONS[entry.icon]}></svg></span> : null}
                <span class="quick-nav-label">{entry.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div id="section-menu-items" class="site-menu" role="dialog" aria-modal="true" aria-label={MENU_DIALOG_LABEL} hidden>
      <div class="site-menu-head">
        <button class="site-menu-close" type="button" aria-label={MENU_CLOSE_LABEL} data-menu-close>
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
        </button>
        <span class="seal seal-menu" aria-hidden="true"><SealMark /></span>
        <span class="site-menu-title"><BrandName locale={locale} title={LOGO_TITLE} /></span>
        <ThemeToggle id="theme-toggle-menu" toDark={THEME_TO_DARK_LABEL} toLight={THEME_TO_LIGHT_LABEL} />
      </div>
      <nav class="site-menu-nav" aria-label={MENU_LABEL}>
        {mobileGroups.map((group, groupIndex) => {
          const body = group.sections.map((section, sectionIndex) => (
            <>
              {section.title ? <h3 class="site-menu-subtitle">{section.title}</h3> : null}
              <ul class={`site-menu-list site-menu-list-${section.layout}`}>
                {/* Link nội bộ lấy tên truy cập từ nhãn (`aria-labelledby`) để vẫn đúng tên trang;
                    link http(s) giữ nguyên nội dung để đọc được "(mở tab mới)". */}
                {section.entries.map((entry, entryIndex) => {
                  const labelId = `menu-label-${groupIndex}-${sectionIndex}-${entryIndex}`;
                  return (
                    <li>
                      <a
                        class={`site-menu-link site-menu-${section.layout === 'tiles' ? 'tile' : section.layout === 'chips' ? 'chip' : 'row'}`}
                        href={entry.href}
                        target={entry.external ? '_blank' : null}
                        rel={entry.external ? EXTERNAL_REL : null}
                        aria-current={currentMark(entry.id) ?? entry.ariaCurrent ?? null}
                        aria-labelledby={entry.external ? null : labelId}
                      >
                        {entry.icon ? <span class="site-menu-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={SECTION_ICONS[entry.icon]}></svg></span> : null}
                        <span class="site-menu-label" id={entry.external ? null : labelId}>{entry.label}{entry.offsite ? <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6"></path><path d="M20 4l-9 9"></path><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path></svg> : null}{entry.external ? <span class="visually-hidden">{NEW_TAB_LABEL}</span> : null}</span>
                        {section.layout === 'rows' ? <svg class="site-menu-arrow" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="13 6 19 12 13 18"></polyline></svg> : null}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </>
          ));
          return group.collapsible
            ? (
              <details class="site-menu-group site-menu-more" open={group.open}>
                <summary class="site-menu-more-toggle">
                  <span>{group.title}</span>
                  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </summary>
                <div class="site-menu-more-body">{body}</div>
              </details>
            )
            : (
              <section class="site-menu-group">
                {group.titleHref
                  ? <a class="site-menu-group-title site-menu-group-link" href={group.titleHref} aria-current={group.titleCurrent ? 'page' : null}>{group.title}</a>
                  : <h2 class="site-menu-group-title">{group.title}{group.titleBadge ? <span class="badge-beta">Beta</span> : null}</h2>}
                {body}
              </section>
            );
        })}
      </nav>
      <div class="site-menu-foot">
        <a class="site-menu-lang" href={counterpartPath} hreflang={HREFLANG[switchLocale]} lang={HREFLANG[switchLocale]} aria-label={SWITCH_ARIA} data-lang-switch>{SWITCH_LABEL}</a>
        <a class="header-cta" href={href('/doi-chuan/')}>{OPEN_GUIDE_MOBILE_LABEL}<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="13 6 19 12 13 18"></polyline></svg></a>
      </div>
    </div>

    <slot name="notice" />

    <main id="main-content" class:list={['layout', landing && 'layout-landing']}>
      <div class={contentClass}>
        {sectionLabel && activeSection !== 'lookup' && !PRERENDERED_TEAM_SECTIONS.includes(activeSection ?? '') ? <noscript><h1 class="reference-title">{sectionLabel}</h1><p class="scope-note">{SECTION_NOSCRIPT_MESSAGE}</p></noscript> : null}
        {seasonScope ? <div id="season-controls" class="season-controls" role="group" aria-label={SCOPE_GROUP_LABEL}></div> : null}
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="footer-grid">
        <div class="footer-about">
          <a class="footer-brand" href={href('/')}><span class="seal seal-footer" aria-hidden="true"><SealMark /></span><span class="footer-title"><BrandName locale={locale} title={LOGO_TITLE} /></span></a>
          <p class="footer-intro">{FOOTER_INTRO}</p>
          <p class="footer-chip"><span class="footer-dot" aria-hidden="true"></span>{UPDATED_LABEL} {updatedOn}</p>
          <!-- Nút chỉ hiện khi js/donate.js, js/feedback.js chạy được (hộp thoại cần JavaScript để mở). -->
          <div class="footer-actions">
            <button type="button" class="footer-action" data-donate-open aria-controls="donate-dialog" hidden>
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path></svg>
              {DONATE_LABEL}
            </button>
            <button type="button" class="footer-action" data-feedback-open aria-controls="feedback-dialog" hidden>
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H9l-5 4z"></path><path d="M8 9h8"></path><path d="M8 12h5"></path></svg>
              {FEEDBACK_LABEL}
            </button>
          </div>
        </div>
        {footerColumns.map((column) => (
          <nav class="footer-col" aria-label={column.title}>
            <h2 class="footer-col-title">{column.titleHref ? <a class="footer-col-title-link" href={column.titleHref}>{column.title}</a> : column.title}</h2>
            <ul class="footer-col-list">
              {column.entries.map((entry) => (
                <li><a class="footer-link" href={entry.href}>{entry.label}</a></li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
      <!-- ≤820px js/site-chrome.js thu gọn link game sau nút mũi tên (tên truy cập lấy từ tiêu đề dải); không JS hoặc
           màn rộng thì luôn hiện đủ. Khối bọc là `display: contents` ở desktop nên dải vẫn một hàng như cũ. -->
      <nav class="footer-game" aria-label={GAME_STRIP_TITLE}>
        <div class="footer-game-head">
          <h2 id="footer-game-title" class="footer-game-title">{GAME_STRIP_TITLE}</h2>
          <p class="footer-game-subtitle">{GAME_STRIP_SUBTITLE}</p>
          <button class="footer-game-toggle" type="button" aria-expanded="true" aria-controls="footer-game-links" aria-labelledby="footer-game-title" data-footer-game-toggle hidden>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
          </button>
        </div>
        <div id="footer-game-links" class="footer-game-links">
          <ul class="footer-game-list">
            {OFFICIAL_LINKS.map((entry) => (
              <li><a class="footer-link" href={entry.href} target={entry.external ? '_blank' : null} rel={entry.external ? EXTERNAL_REL : null}>{localizedLinkLabel(entry, locale)}<svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6"></path><path d="M20 4l-9 9"></path></svg>{entry.external ? <span class="visually-hidden">{NEW_TAB_LABEL}</span> : null}</a></li>
            ))}
            <li><a class="footer-link" href={href(DOWNLOAD_HREF)}>{DOWNLOAD_TITLE}</a></li>
          </ul>
          <span class="footer-game-divider" aria-hidden="true"></span>
          <ul class="footer-game-list footer-community-list">
            {COMMUNITY_LINKS.map((entry) => (
              <li><a class="footer-link" href={entry.href} target={entry.external ? '_blank' : null} rel={entry.external ? EXTERNAL_REL : null}>{localizedLinkLabel(entry, locale)}<svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6"></path><path d="M20 4l-9 9"></path></svg>{entry.external ? <span class="visually-hidden">{NEW_TAB_LABEL}</span> : null}</a></li>
            ))}
          </ul>
        </div>
      </nav>
      <div class="footer-bottom">
        <span>{COPYRIGHT}</span>
        <span>{CREDIT_LABEL} <strong translate="no">{CREDIT}</strong></span>
      </div>
    </footer>

    <dialog id="donate-dialog" class="footer-dialog" aria-labelledby="donate-dialog-title">
      <div class="donate-dialog-body">
        <button type="button" class="icon-btn footer-dialog-close" data-donate-close aria-label={DONATE_CLOSE_LABEL}>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
        </button>
        <span class="seal seal-donate" aria-hidden="true"><SealMark /></span>
        <h2 id="donate-dialog-title" class="donate-dialog-title">{DONATE_LABEL}</h2>
        <p class="donate-dialog-lead">{DONATE_LEAD}</p>
        <figure class="donate-dialog-payment">
          <img class="donate-dialog-qr" src={DONATE_QR_PATH} alt={DONATE_QR_ALT} loading="lazy" decoding="async" />
          <figcaption class="donate-dialog-recipient">
            <strong>NGUYEN LE THAI NGUYEN</strong>
            <span>*******096</span>
          </figcaption>
        </figure>
        <p class="donate-dialog-note">{DONATE_NOTE}</p>
      </div>
    </dialog>

    <!-- Góp ý, sửa lỗi: js/feedback.js gửi tới /api/feedback; Turnstile chỉ nạp khi khách chưa đăng nhập mở hộp thoại. -->
    <dialog id="feedback-dialog" class="footer-dialog feedback-dialog" aria-labelledby="feedback-dialog-title">
      <form class="feedback-dialog-body" novalidate data-feedback-form>
        <button type="button" class="icon-btn footer-dialog-close" data-feedback-close aria-label={DONATE_CLOSE_LABEL}>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
        </button>
        <h2 id="feedback-dialog-title" class="donate-dialog-title">{FEEDBACK_LABEL}</h2>
        <p class="donate-dialog-lead">{FEEDBACK_LEAD}</p>
        <div class="cm-field">
          <label class="cm-label" for="feedback-kind">{FEEDBACK_KIND_LABEL}</label>
          <select id="feedback-kind" class="cm-select" name="kind">
            {FEEDBACK_KINDS.map((kind) => <option value={kind.id}>{t(kind.vi, kind.zh)}</option>)}
          </select>
        </div>
        <div class="cm-field">
          <label class="cm-label" for="feedback-title">{FEEDBACK_TITLE_LABEL}</label>
          <input id="feedback-title" class="cm-input" name="title" type="text" maxlength="120" required />
        </div>
        <div class="cm-field">
          <label class="cm-label" for="feedback-body">{FEEDBACK_BODY_LABEL}</label>
          <textarea id="feedback-body" class="cm-textarea" name="body" rows="5" maxlength="4000" required></textarea>
        </div>
        <div class="cm-field">
          <label class="cm-label" for="feedback-email">{FEEDBACK_EMAIL_LABEL}</label>
          <input id="feedback-email" class="cm-input" name="email" type="email" maxlength="254" autocomplete="email" />
        </div>
        <div class="feedback-turnstile" data-feedback-turnstile hidden></div>
        <p class="cm-status" role="status" aria-live="polite" data-feedback-status hidden></p>
        <div class="cm-form-row">
          <button type="submit" class="ana-btn primary">{FEEDBACK_SUBMIT_LABEL}</button>
        </div>
      </form>
    </dialog>

    <script is:inline type="application/json" id="recommended-publication" set:html={JSON.stringify(website.recommended.pin)}></script>
    <script is:inline type="application/json" id="website-display-publication" set:html={JSON.stringify(website.pin)}></script>
    {seasonHashes && <script is:inline type="application/json" id="season-artifact-hashes" set:html={JSON.stringify(seasonHashes)}></script>}
    {booksHash && <script is:inline type="application/json" id="lookup-books-hash" set:html={JSON.stringify(booksHash)}></script>}
    {bookAliasesJson && <script is:inline type="application/json" id="lookup-book-aliases" set:html={bookAliasesJson}></script>}
    {routeHandles && <script is:inline type="application/json" id="team-route-handles" set:html={JSON.stringify(routeHandles)}></script>}
    {lookupRouteTable && <script is:inline type="application/json" id="lookup-route-handles" set:html={lookupRouteTable}></script>}
    {tacticDisplayJson && <script is:inline type="application/json" id="tactic-display-names" set:html={tacticDisplayJson}></script>}
    <script is:inline type="module">
      import { initSiteChrome } from '/js/site-chrome.js';
      initSiteChrome();
    </script>
    <script is:inline type="module" src="/js/donate.js"></script>
    <script is:inline type="module" src="/js/feedback.js"></script>
    <slot name="scripts" />
  </body>
</html>
