const THEME_TO_LIGHT_LABEL = t('Chuyển sang giao diện sáng', '切换到浅色模式', 'ライトモードに切り替え');
/**
 * Nhóm chuyển ngôn ngữ (`nav[data-lang-switcher]`, header + chân menu mobile): một link cho mỗi locale theo thứ tự
 * `SITE_LOCALES`, nhãn viết bằng chính ngôn ngữ đó. Link của bản đang xem trỏ về chính trang (không phải link chết),
 * mang `aria-current="page"` và `data-lang-current`; link sang bản khác mang `data-lang-switch` và tên truy cập nói rõ
 * hành động bằng ngôn ngữ trang (`languageSwitchAria`, thiếu cặp thì build lỗi). js/site-chrome.js giữ query/hash.
 */
const LANG_SWITCHER_LABEL = t('Ngôn ngữ', '语言', '言語');
/** Nút chọn ngôn ngữ trên header: hiện mã bản đang xem (VI/ZH/JA); tên truy cập nói cả nhãn nhóm lẫn bản đang xem. */
const LANG_PICKER_CODE = locale.toUpperCase();
const LANG_PICKER_ARIA = `${LANG_SWITCHER_LABEL}: ${LOCALE_LABEL[locale]}`;
const languageLinks = SITE_LOCALES.map((target) => {
  const current = target === locale;
  return {
    href: counterpartPaths[target] ?? localePath(stripLocale(Astro.url.pathname), target),
    hreflang: HREFLANG[target],
    label: LOCALE_LABEL[target],
    current,
    aria: current ? null : languageSwitchAria(locale, target),
  };
});
/** Trang mục công cụ dựng nội dung bằng JavaScript: không có JS thì vẫn có tiêu đề mục và lời nhắn này (bốn mục đội và Tra cứu dựng sẵn nên không cần). */
const SECTION_NOSCRIPT_MESSAGE = t(
  'Mục này cần JavaScript để hiển thị nội dung. Hãy bật JavaScript rồi tải lại trang.',
  '此栏目需要 JavaScript 才能显示内容。请启用 JavaScript 后重新加载页面。',
  'このセクションの表示には JavaScript が必要です。JavaScript を有効にしてからページを再読み込みしてください。',
);
const OG_IMAGE_PATH = '/og-image.png';
const COMMUNITY_SECTION_LABEL = pick(locale, 'Cộng đồng', '社区', 'コミュニティ');
const DONATE_LABEL = pick(locale, 'Ủng hộ tác giả', '支持作者', '作者を応援');
const DONATE_LEAD = pick(
  locale,
  'Cẩm nang miễn phí cho mọi người chơi. Nếu thấy hữu ích, bạn có thể ủng hộ tác giả qua mã QR dưới đây — cảm ơn bạn rất nhiều!',
  '本手册对所有玩家免费开放。如果觉得有帮助，欢迎扫描下方二维码支持作者——非常感谢！',
  'この手帳はすべてのプレイヤーに無料で公開しています。役に立ったと感じたら、下の QR コードから作者を応援していただけると嬉しいです。ありがとうございます！',
);
const DONATE_NOTE = pick(locale, 'Quét mã bằng ứng dụng thanh toán trên điện thoại.', '请使用手机上的支付应用扫码。', 'スマートフォンの決済アプリで QR コードを読み取ってください。');
const DONATE_QR_ALT = pick(locale, 'Mã QR ủng hộ tác giả Cẩm Nang TQCCL', '支持《三国志战略版攻略手册》作者的收款二维码', '『三國志 真戦 攻略手帳』の作者を応援する QR コード');
const DONATE_CLOSE_LABEL = pick(locale, 'Đóng', '关闭', '閉じる');
const DONATE_QR_PATH = '/donate-qr.png';
const FEEDBACK_LABEL = t('Góp ý, sửa lỗi', '意见反馈', 'ご意見・不具合報告');
const FEEDBACK_LEAD = t(
  'Báo lỗi, thông tin sai hoặc đề xuất tính năng. Để lại email nếu bạn muốn nhận phản hồi.',
  '报告错误、指出信息有误或提出功能建议。如需回复，请留下邮箱。',
  '不具合や誤った情報の報告、機能の提案をお送りください。返信を希望する場合はメールアドレスをご記入ください。',
);
const FEEDBACK_KIND_LABEL = t('Loại', '类型', '種類');
const FEEDBACK_TITLE_LABEL = t('Tiêu đề', '标题', 'タイトル');
const FEEDBACK_BODY_LABEL = t('Nội dung', '内容', '内容');
const FEEDBACK_EMAIL_LABEL = t('Email (tuỳ chọn, để trả lời)', '邮箱（选填，用于回复）', 'メールアドレス（任意、返信用）');
const FEEDBACK_SUBMIT_LABEL = t('Gửi góp ý', '提交反馈', '送信する');
// Thanh đồng ý phân tích (js/consent-banner.js) và nút "Cài đặt cookie" ở footer: nói rõ GA đếm gì, không quảng cáo, đồng ý
// và từ chối khác nhau ở đâu (cookie, từ khoá tìm); chi tiết ở trang Chính sách bảo mật (nhãn và đường dẫn lấy từ POLICY_PAGES).
const PRIVACY_PAGE = POLICY_PAGES.find((page) => page.path === '/chinh-sach-bao-mat/');
if (!PRIVACY_PAGE) throw new Error('SiteLayout: POLICY_PAGES thiếu trang Chính sách bảo mật');
const CONSENT_LABEL = t('Đồng ý cookie và phân tích', 'Cookie 与统计设置', 'Cookie と分析の設定');
const CONSENT_TEXT = t(
  'Cẩm Nang TQCCL dùng Google Analytics để đếm lượt xem trang và biết tính năng nào được dùng; không có quảng cáo. Nếu bạn đồng ý, Google lưu cookie đo lường và nhận cả từ khoá bạn tìm. Nếu từ chối hoặc chưa chọn, không có cookie hay mã nhận dạng lâu dài, nhưng lượt xem trang và tính năng bạn dùng (không kèm từ khoá tìm) vẫn được gửi dưới dạng tín hiệu không cookie.',
  '本站使用 Google Analytics 统计页面浏览量和功能使用情况，不投放任何广告。选择同意后，Google 会保存统计用 Cookie，并接收你的搜索关键词。拒绝或尚未选择时，不使用 Cookie，也没有长期标识符，但页面浏览量和你使用的功能（不含搜索关键词）仍会以无 Cookie 信号的形式发送。',
