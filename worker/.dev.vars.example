# Copy thành `.dev.vars` (gitignored) cho `wrangler dev`. Production dùng
# `wrangler secret put <NAME>`. KHÔNG commit secret thật.
TURNSTILE_SECRET=0x4xxxxxxxxxxxxxxxxxxx
# Khoá HMAC băm IP (ngẫu nhiên >= 32 byte, vd `openssl rand -base64 48`); thiếu -> /analyze trả 503.
IP_HASH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Khoá giải mã danh sách nhà cung cấp AI (KV `ai:providers`); PHẢI trùng giá trị với community-worker.
# Ngẫu nhiên >= 32 byte (vd `openssl rand -base64 48`); thiếu -> /analyze trả 503.
AI_CONFIG_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
