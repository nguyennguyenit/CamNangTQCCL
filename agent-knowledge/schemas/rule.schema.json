{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "type": "string",
      "enum": [
        "invariant",
        "guidance",
        "preference"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "active",
        "deprecated"
      ]
    },
    "workflows": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "lookup",
          "coexist",
          "research"
        ]
      }
    },
    "stage": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "region": {
          "type": "string",
          "enum": [
            "cn",
            "global",
            "vn"
          ]
        },
        "locale": {
          "type": "string",
          "enum": [
            "vi",
            "zh"
          ]
        },
        "ruleset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sourceSeasonId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "when": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "require-context"
            },
            "fields": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "seasonal",
                  "configChanged",
                  "rosterKnown",
                  "requireAvailable",
                  "region",
                  "locale",
                  "ruleset",
                  "sourceSeasonId",
                  "externalCallsRemaining"
                ]
              }
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "disallow-claim"
            },
            "claim": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          "required": [
            "type",
            "claim"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "show-warning"
            },
            "code": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          "required": [
            "type",
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "prefer-output-format"
            },
            "outputKey": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "format": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          "required": [
            "type",
            "outputKey",
            "format"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "route-workflow"
            },
            "workflow": {
              "type": "string",
              "enum": [
                "lookup",
                "coexist",
                "research"
              ]
            }
          },
          "required": [
            "type",
            "workflow"
          ],
          "additionalProperties": false
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "terms": {
      "type": "string",
      "maxLength": 400
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "sourceRefs": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "origin": {
      "type": "string",
      "enum": [
        "existing-project-contract",
        "design-proposal",
        "skill-migration"
      ]
    },
    "validFrom": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reviewAfter": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "supersedes": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
      }
    },
    "successor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "regressionCaseIds": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    }
  },
  "required": [
    "id",
    "revision",
    "kind",
    "status",
    "workflows",
    "stage",
    "scope",
    "when",
    "action",
    "title",
    "terms",
    "explanation",
    "sourceRefs",
    "origin",
    "validFrom",
    "reviewAfter",
    "supersedes",
    "successor",
    "regressionCaseIds"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "enum": [
                "seasonal",
                "configChanged",
                "rosterKnown",
                "requireAvailable",
                "region",
                "locale",
                "ruleset",
                "sourceSeasonId",
                "externalCallsRemaining"
              ]
            },
            "op": {
              "type": "string",
              "const": "eq"
            },
            "value": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "required": [
            "field",
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "enum": [
                "seasonal",
                "configChanged",
                "rosterKnown",
                "requireAvailable",
                "region",
                "locale",
                "ruleset",
                "sourceSeasonId",
                "externalCallsRemaining"
              ]
            },
            "op": {
              "type": "string",
              "const": "in"
            },
            "value": {
              "minItems": 1,
              "maxItems": 32,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 128
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "required": [
            "field",
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "enum": [
                "seasonal",
                "configChanged",
                "rosterKnown",
                "requireAvailable",
                "region",
                "locale",
                "ruleset",
                "sourceSeasonId",
                "externalCallsRemaining"
              ]
            },
            "op": {
              "type": "string",
              "const": "exists"
            }
          },
          "required": [
            "field",
            "op"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
