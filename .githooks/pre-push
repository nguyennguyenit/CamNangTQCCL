#!/usr/bin/env bash
# Local pre-push gate. Enable with: git config core.hooksPath .githooks
# Runs the fast checks CI does not cover on direct pushes; see README "Pre-push hook".
set -euo pipefail

relevant=0
to_main=0
while read -r local_ref local_sha remote_ref _remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue
  [[ "$local_sha" =~ ^0+$ ]] && continue
  [[ "$local_ref" == refs/tags/* || "$remote_ref" == refs/tags/* ]] && continue
  relevant=1
  [[ "$remote_ref" == "refs/heads/main" ]] && to_main=1
done

if [[ "$relevant" -eq 0 ]]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

# The checks read files on disk, not the commits being pushed.
if ! git diff --quiet HEAD || [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
  echo "pre-push: working tree is dirty; the checks would not match what you push." >&2
  echo "pre-push: commit your changes or run 'git stash -u', then push again." >&2
  exit 1
fi

for dir in mcp-worker community-worker; do
  if [[ ! -d "$dir/node_modules" ]]; then
    echo "pre-push: $dir/node_modules is missing; run '(cd $dir && npm ci)' first." >&2
    exit 1
  fi
done

step() { echo "pre-push: $*" >&2; }

step "mcp-worker: local secrets, workflow build, knowledge bundle, typecheck"
(cd mcp-worker \
  && npm run --silent check:local-secrets \
  && npm run --silent check:workflow-build \
  && npm run --silent check:knowledge-bundle \
  && npm run --silent typecheck)

step "community-worker: tests, typecheck"
(cd community-worker && npm test --silent && npm run --silent typecheck)

step "python unittest"
python3 -m unittest discover -s tests

if [[ "$to_main" -eq 1 ]]; then
  step "push to main: build + verify (same gate as pages-deploy.yml)"
  npm run build
  npm run verify
fi

step "ok"
