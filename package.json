{
  "name": "cam-nang-tqccl",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "python3 -m pipeline.site_localization check --root . --stage public && astro build",
    "check": "python3 -m pipeline.site_localization check --root . --stage public && astro check",
    "preview": "astro preview",
    "test:contracts": "node --test tests-js/runtime-asset-contract.test.mjs",
    "test:dist": "node --experimental-strip-types --test tests-js/astro-dist-contract.test.mjs tests-js/pages-headers-contract.test.mjs",
    "test:dev-contract": "node --test tests-js/astro-dev-contract.test.mjs",
    "test:node": "node --experimental-strip-types --test tests-js/*.test.mjs",
    "verify": "python3 -m pipeline.site_localization check --root . --stage public && node scripts/verify-astro-dist.mjs",
    "test:e2e": "playwright test",
    "test:e2e:astro": "playwright test --project=astro"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "astro": "7.1.3",
    "typescript": "6.0.3"
  }
}
