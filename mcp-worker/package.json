{
  "name": "tqccl-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "generate:workflow-build": "node --import tsx scripts/generate-workflow-build.ts",
    "check:workflow-build": "node --import tsx scripts/generate-workflow-build.ts --check",
    "generate:knowledge-bundle": "node --import tsx scripts/generate-knowledge-bundle.ts",
    "check:knowledge-bundle": "node --import tsx scripts/generate-knowledge-bundle.ts --check",
    "cli": "node --import tsx src/cli.ts",
    "stdio": "node --import tsx src/stdio.ts",
    "provision:bearer": "node --import tsx scripts/provision-bearer-token.ts",
    "build:worker-assets": "node --import tsx scripts/build-worker-assets.ts",
    "verify:worker-assets": "node --import tsx scripts/verify-worker-assets.ts",
    "read:worker-version-upload": "node --import tsx scripts/read-wrangler-version-upload.ts",
    "preflight:worker-release": "node --import tsx scripts/preflight-worker-release.ts",
    "release:worker": "node --import tsx scripts/release-worker-version.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:release": "vitest run test/release",
    "test:stdio": "vitest run test/transport/stdio.integration.test.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts && vitest run --config vitest.worker-production.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p test/tsconfig.json",
    "wrangler:types": "wrangler types src/worker-configuration.d.ts",
    "verify:control-plane": "node --import tsx scripts/verify-control-plane.ts --artifact-only",
    "verify:release": "node --import tsx scripts/verify-release.ts",
    "check:local-secrets": "node --import tsx scripts/check-local-secret-files.ts",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler-dist",
    "build": "tsc -p tsconfig.build.json",
    "test:node-min": "node test/node-min-smoke.mjs",
    "check": "npm run check:workflow-build && npm run check:knowledge-bundle && npm run check:local-secrets && npm run test:coverage && npm run typecheck && npm run typecheck:worker && npm run build && npm run test:node-min && npm run verify:control-plane",
    "check:repository": "node --import tsx scripts/check-repository.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@cloudflare/workers-types": "5.20260728.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  }
}
