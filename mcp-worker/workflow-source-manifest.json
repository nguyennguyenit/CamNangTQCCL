  "buildInputs": [
    ".node-version",
    "mcp-worker/package-lock.json",
    "mcp-worker/package.json",
    "mcp-worker/scripts/generate-workflow-build.ts",
    "mcp-worker/tsconfig.build.json",
    "mcp-worker/tsconfig.json",
    "mcp-worker/workflow-source-manifest.json"
  ],
  "exclusions": [
    {
      "path": "mcp-worker/test",
      "reason": "Kiểm thử xác minh hành vi nhưng không chạy trong workflow sản xuất."
    },
    {
      "path": "mcp-worker/src/generated/workflow-build.ts",
      "reason": "Đầu ra được sinh từ chính các nguồn đã băm; đưa vào closure sẽ tạo vòng lặp."
    },
    {
      "path": "data",
      "reason": "Dữ liệu được định danh riêng bằng releaseId và kết hợp ở workflowVersion."
    }
  ]
}
