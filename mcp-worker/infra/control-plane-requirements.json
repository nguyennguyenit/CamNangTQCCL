{
  "schemaVersion": 1,
  "productionEnabledOnlyWhenVerified": true,
  "controls": [
    {
      "id": "edge-mcp-rate-limit",
      "owner": "Cloudflare zone security administrator",
      "evidenceOwner": "Phase 6 release verifier",
      "endpoint": "/zones/{zone_id}/rulesets/phases/http_ratelimit/entrypoint",
      "expected": {
        "ruleDescription": "tqccl-mcp-rate-limit",
        "enabled": true,
        "expression": "http.request.uri.path eq \"/mcp\"",
        "action": "block",
        "maximumRequests": 60,
        "periodSeconds": 60
      },
      "failureBehavior": "Chặn phát hành HTTP production.",
      "rollbackBehavior": "Tắt route MCP nếu không thể khôi phục rule."
    }
  ]
}
