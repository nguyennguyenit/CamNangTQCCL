{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tqccl-research-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-28",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "mcp.tqccl.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./.worker-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "secrets": {
    "required": ["TQCCL_MCP_BEARER_CURRENT"]
  },
  "vars": {
    "TQCCL_MCP_ALLOWED_ORIGINS": "",
    "TQCCL_MCP_MAX_BODY_BYTES": "65536",
    "TQCCL_MCP_MAX_RESULT_BYTES": "98304",
    "TQCCL_MCP_RATE_MAX": "60",
    "TQCCL_MCP_RATE_WINDOW_MS": "60000",
    "TQCCL_MCP_MAX_IN_FLIGHT": "4"
  }
}
